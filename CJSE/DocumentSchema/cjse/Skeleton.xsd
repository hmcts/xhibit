<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns="http://www.courtservice.gov.uk/schemas/courtservice" xmlns:cs="http://www.courtservice.gov.uk/schemas/courtservice" xmlns:apd="http://www.govtalk.gov.uk/people/AddressAndPersonalDetails" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.courtservice.gov.uk/schemas/courtservice" elementFormDefault="qualified" attributeFormDefault="unqualified" version="5.3" id="Skeleton">
	<xsd:include schemaLocation="CourtService.xsd"/>
	<xsd:annotation>
		<xsd:appinfo>
			<Metadata xmlns="http://www.govtalk.gov.uk/metadata/egms">
				<Creator>Department for Constitutional Affairs</Creator>
				<Created>2002-05-28</Created>
				<Modified>2005-10-06</Modified>
				<Format Schema="http://www.iana.org/assignments/media-types">text/xml</Format>
				<Identifier>Skeleton</Identifier>
				<Language codeListID="ISO639-2" codeListURI="http://www.loc.gov/standards/iso639-2/langcodes.html">eng</Language>
				<Publisher>Department for Constitutional Affairs, Clive House, 70 Petty France, London, SW1H 9HD</Publisher>
				<ConformsTo>http://www.w3.org/2001/XMLSchema</ConformsTo>
				<Copyright>Crown Copyright 2006</Copyright>
				<ProtectiveMarking>unclassified</ProtectiveMarking>
				<Status>final</Status>
				<StatusDescription>definitive version for release</StatusDescription>
				<Version>5.3</Version>
				<Category codeListID="GCL">Justice System</Category>
				<Title>Crown Court Skeleton List</Title>
				<Type>message</Type>
			</Metadata>
		</xsd:appinfo>
	</xsd:annotation>
	<xsd:simpleType name="WitnessStatusType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="Ordinary"/>
			<xsd:enumeration value="Expert"/>
			<xsd:enumeration value="Interpreter"/>
			<xsd:enumeration value="Juvenile"/>
			<xsd:enumeration value="Police Officer"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="WitnessTypeType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="Prosecution"/>
			<xsd:enumeration value="Defence"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="WitnessStructure">
		<xsd:complexContent>
			<xsd:extension base="PersonStructure">
				<xsd:attribute name="Time" type="xsd:time" use="required"/>
				<xsd:attribute name="WitnessType" type="WitnessTypeType" use="required"/>
				<xsd:attribute name="WitnessStatus" type="WitnessStatusType" use="optional"/>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="DayStructure">
		<xsd:sequence>
			<xsd:element name="AMsession" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="Witnesses" minOccurs="0">
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="Witness" type="WitnessStructure" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="AMnotes" type="xsd:string" minOccurs="0"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="PMsession" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="Witnesses" minOccurs="0">
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="Witness" type="WitnessStructure" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="PMnotes" type="xsd:string" minOccurs="0"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute name="Date" type="xsd:date" use="optional"/>
	</xsd:complexType>
	<xsd:complexType name="SkeletonScheduleStructure">
		<xsd:sequence>
			<xsd:element name="DocumentID" type="DocumentIDstructure"/>
			<xsd:element name="IssuingCourtHouse" type="CourtHouseStructure"/>
			<xsd:element name="CaseNumber" type="CaseNumberType"/>
			<xsd:element name="CaseTitle" type="xsd:string"/>
			<xsd:element name="VenueCourtHouse" type="CourtHouseStructure" minOccurs="0"/>
			<xsd:element name="Days">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="Day" type="DayStructure" maxOccurs="unbounded"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="SkeletonSchedule" type="SkeletonScheduleStructure"/>
</xsd:schema>
