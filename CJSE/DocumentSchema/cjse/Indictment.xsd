<xsd:schema xmlns="http://www.courtservice.gov.uk/schemas/courtservice" xmlns:cs="http://www.courtservice.gov.uk/schemas/courtservice" xmlns:apd="http://www.govtalk.gov.uk/people/AddressAndPersonalDetails" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.courtservice.gov.uk/schemas/courtservice" elementFormDefault="qualified" attributeFormDefault="unqualified" version="5.3" id="Indictment">
	<xsd:include schemaLocation="CourtService.xsd"/>
	<xsd:annotation>
		<xsd:appinfo>
			<Metadata xmlns="http://www.govtalk.gov.uk/metadata/egms">
				<Creator>Department for Constitutional Affairs</Creator>
				<Created>2002-05-28</Created>
				<Modified>2005-10-06</Modified>
				<Format Schema="http://www.iana.org/assignments/media-types">text/xml</Format>
				<Identifier>Indictment</Identifier>
				<Language codeListID="ISO639-2" codeListURI="http://www.loc.gov/standards/iso639-2/langcodes.html">eng</Language>
				<Publisher>Department for Constitutional Affairs, Clive House, 70 Petty France, London, SW1H 9HD</Publisher>
				<ConformsTo>http://www.w3.org/2001/XMLSchema</ConformsTo>
				<Copyright>Crown Copyright 2006</Copyright>
				<ProtectiveMarking>unclassified</ProtectiveMarking>
				<Status>final</Status>
				<StatusDescription>definitive version for release</StatusDescription>
				<Version>5.3</Version>
				<Category codeListID="GCL">Justice System</Category>
				<Title>Crown Court Indictment</Title>
				<Type>message</Type>
			</Metadata>
		</xsd:appinfo>
	</xsd:annotation>
	<xsd:complexType name="IndictmentStructure">
		<xsd:sequence>
			<xsd:element name="DocumentID" type="DocumentIDstructure"/>
			<xsd:element name="IssuingCourtHouse" type="CourtHouseStructure"/>
			<xsd:element name="Cases">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="CaseNumber" type="CaseNumberType" maxOccurs="unbounded"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="DateReceived" type="xsd:date" minOccurs="0"/>
			<xsd:element name="Signed" type="YesNoType"/>
			<xsd:element name="DateSigned" type="xsd:date" minOccurs="0"/>
			<xsd:element name="SigningOfficer" type="PersonalDetailsStructure" minOccurs="0"/>
			<xsd:element name="Defendants" type="IndictmentDefendantsType"/>
			<xsd:element name="JoinderIndictment" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="DateJoined" type="xsd:date"/>
						<xsd:element name="PreferedByJudge" type="cs:JudiciaryStructure"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute name="IsJoinderIndictment" type="YesNoType" use="required"/>
	</xsd:complexType>
	<xsd:element name="Indictment" type="IndictmentStructure"/>
	<xsd:complexType name="IndictmentDefendantsType">
		<xsd:sequence>
			<xsd:element name="Defendant" type="DefendantStructure" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
