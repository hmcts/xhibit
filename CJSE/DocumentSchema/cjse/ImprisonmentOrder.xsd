	<xsd:complexType name="ImprisonmentOrderStructure">
		<xsd:sequence>
			<xsd:element name="DocumentID" type="DocumentIDstructure"/>
			<xsd:element name="OrderHeader" type="CourtOrderHeaderStructure"/>
			<xsd:element name="Conviction">
				<xsd:complexType>
					<xsd:choice>
						<xsd:element name="ConvictionDate" type="xsd:date"/>
						<xsd:element name="ConvictingCourt" type="OriginatingCourtStructure"/>
					</xsd:choice>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="RiskVulnerabilityFactors" type="xsd:string" minOccurs="0"/>
			<xsd:element name="CustodialTerm" type="CustodialTermStructure"/>
			<xsd:element name="RequiredCustodial" type="YesNoType" default="no" minOccurs="0"/>
			<xsd:element name="CreditOnRemand" type="CreditOnRemandStructure" minOccurs="0"/>
			<xsd:element name="CreditOnBail" type="CreditOnBailStructure" minOccurs="0"/>
			<xsd:element name="CJA2003RequiredCustodial" type="YesNoType" default="no" minOccurs="0"/>
			<xsd:element name="ClassAtrafficking" type="YesNoType" minOccurs="0"/>
			<xsd:element name="DomesticBurglary" type="YesNoType" minOccurs="0"/>
			<xsd:element name="ReturnToImprisonment" type="ReturnToImprisonmentStructure" minOccurs="0"/>
			<xsd:element name="Section28" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="DiscretionaryRelevantPart" type="xsd:duration"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="Section86" type="YesNoType" default="no" minOccurs="0"/>
			<xsd:element name="AdditionalNotes" type="xsd:string" minOccurs="0"/>
			<xsd:element name="RecommendedDeportation" type="YesNoType" default="no" minOccurs="0"/>
			<xsd:element name="AutomaticDeportation" type="YesNoType" default="no" minOccurs="0"/>
			<!--CCN400 START -->
			<xsd:element name="DeportationSection" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="DeportationReasons" type="DeportationStructure"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<!-- CCN400 END -->
			<xsd:element name="AssociatedCases" type="AssociatedCaseStructure" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="ImprisonmentOrder" type="ImprisonmentOrderStructure"/>
