<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns="http://www.hmcs.gov.uk/schemas/crowncourt/msg" 
	    xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
	    xmlns:cs="http://www.courtservice.gov.uk/schemas/courtservice" 
	    xmlns:ccm="http://www.hmcs.gov.uk/schemas/crowncourt/msg" 
	    attributeFormDefault="unqualified" 
	    elementFormDefault="qualified" 
	    targetNamespace="http://www.hmcs.gov.uk/schemas/crowncourt/msg" 
	    id="CaseInfo"
	    version="1.1">

	<xsd:import namespace="http://www.courtservice.gov.uk/schemas/courtservice" schemaLocation="CourtService.xsd"/>

	<xsd:annotation>
		<xsd:appinfo>
			<Metadata xmlns="http://www.govtalk.gov.uk/metadata/egms">
				<Creator>Department for Constitutional Affairs</Creator>
				<Created>2006-07-21</Created>
				<Modified>2006-07-27</Modified>
				<Format Schema="http://www.iana.org/assignments/media-types">text/xml</Format>
				<Identifier>CaseInfo</Identifier>
				<Language codeListID="ISO639-2" codeListURI="http://www.loc.gov/standards/iso639-2/langcodes.html">eng</Language>
				<Publisher>Department for Constitutional Affairs, Clive House, 70 Petty France, London, SW1H 9HD</Publisher>
				<ConformsTo>http://www.w3.org/2001/XMLSchema</ConformsTo>
				<Copyright>Crown Copyright 2006</Copyright>
				<ProtectiveMarking>unclassified</ProtectiveMarking>
				<Status>final</Status>
				<StatusDescription>definitive version for release</StatusDescription>
				<Version>1.1</Version>
				<Category codeListID="GCL">Justice System</Category>
				<Title>Crown Court Case Information</Title>
				<Type>message</Type>
			</Metadata>
		</xsd:appinfo>
	</xsd:annotation>

	<!-- message types -->
	
	<xsd:complexType name="NewCaseMessageStructure">
		<xsd:annotation>
			<xsd:documentation>
				The structure for a new case message sent from the Court Services Hub towards the Criminal Justice System Exchange.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="DocumentID" type="cs:DocumentIDstructure"/>
			<xsd:element name="Case" type="ccm:CaseStructure"/>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="UpdatedCaseMessageStructure">
		<xsd:annotation>
			<xsd:documentation>
				The structure for an updated case message sent from the Court Services Hub towards the Criminal Justice System Exchange.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="DocumentID" type="cs:DocumentIDstructure"/>
			<xsd:element name="Case" type="ccm:CaseStructure"/>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="DiscontinuedCaseMessageStructure">
		<xsd:annotation>
			<xsd:documentation>
				The structure for a discontinued case message sent from the Court Services Hub towards the Criminal Justice System Exchange.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="DocumentID" type="cs:DocumentIDstructure"/>
			<xsd:element name="Case" type="ccm:CaseStructure"/>
		</xsd:sequence>
	</xsd:complexType>

	<!-- business types -->
	
	<xsd:complexType name="DefendantsStructure">
		<xsd:annotation>
			<xsd:documentation>
				Corrects the faulty definition of Defendants in courtservice.xsd
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="Defendant" type="cs:DefendantStructure" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="CaseStructure">
		<xsd:annotation>
			<xsd:documentation>
				Corrects the anonymous ct definition of Cases in courtservice.xsd. Note that PTIURN has been added.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="CaseNumber" type="cs:CaseNumberType"/>
			<xsd:element name="Court" type="cs:CourtHouseStructure"/>
			<xsd:element name="CaseArrivedFrom" minOccurs="0">
				<xsd:complexType>
					<xsd:choice>
						<xsd:sequence>
							<xsd:element name="OriginatingCourt" type="cs:CourtHouseStructure"/>
							<xsd:element name="OriginatingCourtCaseNumber" type="cs:CaseNumberType" minOccurs="0"/>
						</xsd:sequence>

						<xsd:element name="Section53" type="cs:YesNoType" default="yes"/>
					</xsd:choice>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="Hearing" type="cs:HearingTypeStructure" minOccurs="0"/>
			<xsd:element name="Defendants" type="ccm:DefendantsStructure" minOccurs="0"/>
			<xsd:element name="Prosecution" type="cs:ProsecutionStructure" minOccurs="0"/>
			<xsd:element name="MethodOfInstigation" type="cs:MethodOfInstigationType" minOccurs="0"/>
			<xsd:element name="DateOfInstigation" type="xsd:date" minOccurs="0"/>
			<xsd:element name="CaseClassNumber" type="xsd:positiveInteger" minOccurs="0"/>
			<xsd:element name="PTIURN" type="cs:URNtype" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="DiscontinuedCaseStructure">
		<xsd:annotation>
			<xsd:documentation>
				Represents a notification that a case has been discontinued.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="CaseNumber" type="cs:CaseNumberType"/>
			<xsd:element name="Court" type="cs:CourtHouseStructure"/>
			<xsd:element name="PTIURN" type="cs:URNtype" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>

	<!-- global elements -->
	
	<xsd:element name="NewCaseMessage" type="ccm:NewCaseMessageStructure"/>
	<xsd:element name="UpdatedCaseMessage" type="ccm:UpdatedCaseMessageStructure"/>
	<xsd:element name="DiscontinuedCaseMessage" type="ccm:DiscontinuedCaseMessageStructure"/>
	
</xsd:schema>
