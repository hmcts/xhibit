13:46:50 XHIBIT@CSDBBLD1 > 
13:46:50 XHIBIT@CSDBBLD1 > CREATE OR REPLACE TRIGGER XHB_CR_LIVE_INTERNET_BUR_TR
13:46:50   2  	BEFORE UPDATE OR DELETE
13:46:50   3  	ON XHB_CR_LIVE_INTERNET
13:46:50   4  	FOR EACH ROW
13:46:50   5  DECLARE
13:46:50   6  
13:46:50   7  	l_trig_event VARCHAR2(1) := NULL;
13:46:50   8  
13:46:50   9  	OPTIMISTIC_LOCK_PROB EXCEPTION;
13:46:50  10  	PRAGMA EXCEPTION_INIT(OPTIMISTIC_LOCK_PROB, -20101);
13:46:50  11  
13:46:50  12  BEGIN
13:46:50  13  
13:46:50  14  	/* Determine whether UPDATING or DELETING */
13:46:50  15  	IF UPDATING THEN
13:46:50  16  
13:46:50  17  	  l_trig_event := 'U';
13:46:50  18  
13:46:50  19  	  /* If the user is the connection pool user as defined in XHB_SYS_USER_INFORMATION */
13:46:50  20  	  IF (Xhb_Custom_Pkg.IS_CONNECTION_POOL_USER = 1) THEN
13:46:50  21  
13:46:50  22  	    IF (:OLD.VERSION != :NEW.VERSION) THEN
13:46:50  23  	    /* Someone has pulled the rug out from below! */
13:46:50  24  
13:46:50  25  	      RAISE OPTIMISTIC_LOCK_PROB;
13:46:50  26  
13:46:50  27  	    END IF;
13:46:50  28  
13:46:50  29  	  END IF;
13:46:50  30  
13:46:50  31  	  SELECT :OLD.VERSION + 1,
13:46:50  32  		 SYSDATE
13:46:50  33  	  INTO	 :NEW.VERSION,
13:46:50  34  		 :NEW.LAST_UPDATE_DATE
13:46:50  35  	  FROM	 DUAL;
13:46:50  36  
13:46:50  37  	  /* If the user is not the connection pool user as defined in XHB_SYS_USER_INFORMATION */
13:46:50  38  	  IF (Xhb_Custom_Pkg.IS_CONNECTION_POOL_USER = 0) THEN
13:46:50  39  
13:46:50  40  	      SELECT SYS_CONTEXT('USERENV', 'SESSION_USER')
13:46:50  41  	      INTO   :NEW.LAST_UPDATED_BY
13:46:50  42  	      FROM   DUAL;
13:46:50  43  
13:46:50  44  	  END IF;
13:46:50  45  
13:46:50  46  	ELSE -- Must be DELETING
13:46:50  47  
13:46:50  48  	  l_trig_event := 'D';
13:46:50  49  
13:46:50  50  	END IF;
13:46:50  51  
13:46:50  52  	/* Is Auditing on this table required */
13:46:50  53  	IF (Xhb_Custom_Pkg.IS_AUDIT_REQUIRED('XHB_CR_LIVE_INTERNET') = 1) THEN
13:46:50  54  
13:46:50  55  	  INSERT INTO AUD_CR_LIVE_INTERNET
13:46:50  56  		 ( CR_LIVE_INTERNET_ID,
13:46:50  57  		   COURT_ROOM_ID,
13:46:50  58  		   SCHEDULED_HEARING_ID,
13:46:50  59  		   TIME_STATUS_SET,
13:46:50  60  		   STATUS,
13:46:50  61  		   CREATED_BY,
13:46:50  62  		   CREATION_DATE,
13:46:50  63  		   LAST_UPDATED_BY,
13:46:50  64  		   LAST_UPDATE_DATE,
13:46:50  65  		   VERSION,
13:46:50  66  		   INSERT_EVENT)
13:46:50  67  	  VALUES (:OLD.CR_LIVE_INTERNET_ID,
13:46:50  68  		  :OLD.COURT_ROOM_ID,
13:46:50  69  		  :OLD.SCHEDULED_HEARING_ID,
13:46:50  70  		  :OLD.TIME_STATUS_SET,
13:46:50  71  		  :OLD.STATUS,
13:46:50  72  		  :OLD.CREATED_BY,
13:46:50  73  		  :OLD.CREATION_DATE,
13:46:50  74  		  :OLD.LAST_UPDATED_BY,
13:46:50  75  		  :OLD.LAST_UPDATE_DATE,
13:46:50  76  		  :OLD.VERSION,
13:46:50  77  		  l_trig_event);
13:46:50  78  
13:46:50  79  	END IF;
13:46:50  80  
13:46:50  81  END;
13:46:50  82  /

Trigger created.

