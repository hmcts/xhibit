OPTIONS (
SKIP=1,
READSIZE=5000000,
BINDSIZE=5000000,
ROWS=1000
)
LOAD data
INFILE '$xhb_in_file'
APPEND
INTO TABLE xhbstg_case_dm
WHEN (CREST_COURT_ID != '')
FIELDS TERMINATED BY ',' OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(
CASE_NO
,CASE_TYPE
,PROS_PB_ADV1_TELNO
,DATE_IND_SIGNED
,DATE_IND_REC
,DATE_CONCLUDED
,DATE_CLOSED
,CTL_ID
,COMM_DATE
,CLASS
,CCC_TRANS_TO
,DATE_TRANS_TO_RECORDED
,DATE_TRANS_TO
,DATE_TRANS_FROM
,DATE_REOPENED
,DATE_RECEIVED
,DATE_INPUT
,CCC_TRANS_FROM
,PROS_PB_ADV2
,PROS_PB_ADV2_TELNO
,PSD_CT_CODE
,PSD_REFERENCE
,RECEIPT_TYPE
,REQ_JUDGE_TYPE
,RE_TRIAL
,RL_END_DATE
,SECURITY_IND
,TOTAL_DEFTS
,TRIAL_EXT_DATE
,TRIAL_LAST_DATE
,VIDEO_IND
,DS_IND
,PRLIS_JOB_ID
,BW_DS_IND
,WL_REVIEW_DATE
,EITHER_WAY_TYPE
,FCIR_JOB_ID
,FIX_CONF_DATE
,FIX_REQ_IND
,HO_POL_FORCE
,HO_PSD_HRG_TYPE
,HRG_LEN_LO
,HRG_LEN_LO_UNIT
,HRG_LEN_PSOL
,HRG_LEN_PSOL_UNIT
,INDICT_RESP
,IND_COMMENTS1
,IND_COMMENTS2
,CASE_TITLE
,IND_COMMENTS3
,IND_COMMENTS4
,IND_COMMENTS5
,IND_COMMENTS6
,INIT_HRG_TYPE
,ITLIM_JOB_ID
,LC_CONV_DATE
,LC_SENT_DATE
,LG010_EDITION_NO
,LIVE_STATUS
,NEW_APPEAL_TYPE
,NO_CB_WITS
,NO_FB_WITS
,NO_PROF_WITS
,OBS_BW
,ORIGINAL_CASE_NO
,ORIG_JP1_NAME
,ORIG_JP2_NAME
,ORIG_JP3_NAME
,ORIG_JP4_NAME
,OTHER_PROS_WITS
,PROS_PB_ADV1
,ANT_DELAY_REASONS
,APPEAL_DESCRIPT
,APPEAL_TYPE
,APP_RESULT
,APP_RESULT_DATE
,BC_STATUS
,BW_IND
,CASE_GROUP
,LIST_AVAIL
,PLEA_DIRECTION_DATE
,DEFAULT_LIST_NOTE
,UNLINK_REASON_CODE
,SEVERED_IND
,PAGES_EVIDENCE
,PDH_ESTIMATE
,FULL_TRIAL_STATUS_DATE
,SENT_FOR_TRIAL_DATE
,PROS_PAPERS_SERVED_DATE
,OFFENCE_GROUP_UPGRADE
,DATE_CTL_REMINDER_PRINTED
,CRIME_MONITORING_CATEGORY
,TICKET_REQD
,TICKET_TYPE
,INTIMIDATED_WITNESS
,CREST_COURT_ID
)
