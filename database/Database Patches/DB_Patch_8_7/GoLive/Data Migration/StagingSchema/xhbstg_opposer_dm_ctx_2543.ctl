OPTIONS (
SKIP=1,
READSIZE=5000000,
BINDSIZE=5000000,
ROWS=1000
)
LOAD data
INFILE '$xhb_in_file'
APPEND
INTO TABLE xhbstg_opposer_dm
WHEN (CREST_COURT_ID != '')
FIELDS TERMINATED BY ',' OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(
OPP_ID,
ADDR1,
ADDR2,
ADDR3,
ADDR4,
POSTCODE,
TEL_NO,
TOWN,
COUNTY,
OBS_IND,
FAX_NO,
CPS_CODE,
TITLE,
FORENAME1,
FORENAME2,
INITIALS,
SURNAME,
DX_REF,
OPP_EMAIL,
OPP_EMAIL_SECURE,
CREST_COURT_ID
)
