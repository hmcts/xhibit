OPTIONS (SKIP=1, READSIZE=5000000, BINDSIZE=5000000, ROWS=1000)

LOAD DATA
INFILE '$xhb_in_file'
APPEND
INTO TABLE DATA_MIG.XHBSTG_HOME_COURT_DM
WHEN (CREST_COURT_ID != '')
FIELDS TERMINATED BY ',' OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(
NAME                                    ,
WARNED_PERIOD_CV                        ,
DX_REF                                  ,
PASSWORD_CHANGE_DATE                    ,
PASSWORD_AGE_LIMIT                      ,
SYSAC_END_TIME                          ,
SYSAC_START_TIME                        ,
