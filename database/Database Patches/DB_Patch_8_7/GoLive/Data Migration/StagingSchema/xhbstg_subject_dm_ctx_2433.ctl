OPTIONS (
SKIP=1,
READSIZE=5000000,
BINDSIZE=5000000,
ROWS=1000
)
LOAD data
INFILE '$xhb_in_file'
APPEND
INTO TABLE xhbstg_subject_dm
WHEN (CREST_COURT_ID != '')
FIELDS TERMINATED BY ',' OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(
SUB_ID,
CURRENT_PRISON_STATUS,
DRIVING_LICENCE_NO,
SURNAME,
FORENAME2,
FORENAME1,
TOWN,
COMM_PSD_LA_REF,
GUARDIAN_NAME,
HOSP_POSTCODE,
HOSP_ADDR4,
HOSP_ADDR3,
HOSP_ADDR2,
HOSP_ADDR1,
HOSP_COUNTY,
HOSP_TOWN,
COUNTY,
HOSPITAL_NAME,
CRO_NO,
DOB,
SEX,
POSTCODE,
ADDR4,
ADDR3,
ADDR2,
ADDR1,
INITIALS,
REMAND_PRISON,
AGE,
FORMER_SURNAME,
PRISONER_NO,
GUARDIAN_STATUS,
ETHNIC_APPEARANCE,
PRISON_ID,
CREST_COURT_ID
)
