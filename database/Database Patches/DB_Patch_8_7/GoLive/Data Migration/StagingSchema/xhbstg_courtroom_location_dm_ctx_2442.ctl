OPTIONS (
SKIP=1,
READSIZE=5000000,
BINDSIZE=5000000,
ROWS=1000
)
LOAD data
INFILE '$xhb_in_file' 
APPEND
INTO TABLE xhbstg_courtroom_location_dm
WHEN (CREST_COURT_ID != '')
FIELDS TERMINATED BY ',' OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(
CTL_ID, 
SITE_NAME, 
ADDR1, 
ADDR2, 
ADDR3, 
ADDR4, 
POSTCODE, 
TEL_NO, 
TOWN, 
COUNTY, 
OBS_IND, 
FAX_NO, 
SITE_CODE, 
LCD_STATS_CODE, 
LIST_NAME, 
SITE_GROUP, 
FLOATER_TEXT, 
TIER, 
IND_ONLY_ALLOWED, 
CREST_COURT_ID
)
