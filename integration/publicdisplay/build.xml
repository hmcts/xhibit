<?xml version="1.0" encoding="UTF-8"?>

<project basedir="." default="all" name="DailyListNotifier">

    <description>
        This project creates a notifier used by Mercator
        when a daily list load is complete for a court
        to notify the public displays that a re-render is required.
    </description>

    <import file="./../../tools/ant/framework.xml" />

    <property name="project.type.builds.jar"           value="marker" />
    <property name="project.type.requires.compilation" value="marker" />

    <!--
      =======================================================================
          Initialise Override
      =======================================================================
       -->
    <target name="initialise" unless="skip.initialise" depends="framework.initialise">
        <log target="initialise"/>

        <path id="compile.classpath">
            <path refid="lib.classpath"/>
        </path>
    </target>


</project>
