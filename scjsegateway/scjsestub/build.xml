<?xml version="1.0" encoding="UTF-8"?>

<project basedir="." default="all" name="ScjseStub">

    <description>
        This project contains ...
    </description>

    <import file="./../../tools/ant/framework.xml" />

    <property name="project.type.builds.jar"           value="marker" />
    <property name="project.type.requires.compilation" value="true" />

    <!--
      =======================================================================
        Initialise Override
      =======================================================================
      -->
    <target name="initialise" unless="skip.initialise" depends="framework.initialise">
        <log target="initialise"/>
        <path id="compile.classpath">
            <path refid="lib.classpath"/>
            <path refid="framework.classpath"/>
            <fileset dir="${build.dest.dir}">
                <include name="Framework.jar" />
                <include name="GdGatewayWebService.jar" />
                <include name="GdGatewayWebServiceClient.jar" />
                <include name="GdGatewayXmlBinding.jar" />
                <include name="ScjseGatewayMessaging.jar" />
                <include name="GdGatewayController.jar" />
            </fileset>
        </path>
    </target>

</project>
