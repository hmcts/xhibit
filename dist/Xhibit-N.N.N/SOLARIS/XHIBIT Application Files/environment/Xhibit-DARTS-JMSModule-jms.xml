<?xml version='1.0' encoding='UTF-8'?>
<weblogic-jms xmlns="http://www.bea.com/ns/weblogic/90" xmlns:sec="http://www.bea.com/ns/weblogic/90/security" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:wls="http://www.bea.com/ns/weblogic/90/security/wls" xsi:schemaLocation="http://www.bea.com/ns/weblogic/910/domain.xsd">

   <connection-factory name="DartsMessageConnectionFactory">
    <sub-deployment-name>midcluster-Subdeployment</sub-deployment-name>
    <jndi-name>DartsMessageConnectionFactory</jndi-name>
    <transaction-params>
      <xa-connection-factory-enabled>true</xa-connection-factory-enabled>
    </transaction-params>
    <security-params>
      <attach-jmsx-user-id>false</attach-jmsx-user-id>
    </security-params>
  </connection-factory>

  <topic name="DartsMessageOutboundTopic">
    <sub-deployment-name>midM1-JMSServer-Subdeployment</sub-deployment-name>
    <jndi-name>jms/darts/DartsMessageOutboundTopic</jndi-name>
  </topic>

  <uniform-distributed-queue name="DartsMessageOutboundQueue">
    <sub-deployment-name>midcluster-Subdeployment</sub-deployment-name>
    <delivery-params-overrides>
      <redelivery-delay>5000</redelivery-delay>
    </delivery-params-overrides>
    <delivery-failure-params>
      <redelivery-limit>0</redelivery-limit>
      <expiration-policy>Log</expiration-policy>
      <expiration-logging-policy>%header%,%properties%</expiration-logging-policy>
    </delivery-failure-params>
    <jndi-name>jms/darts/DartsMessageOutboundQueue</jndi-name>
    <load-balancing-policy>Round-Robin</load-balancing-policy>
    <forward-delay>60</forward-delay>
  </uniform-distributed-queue>
</weblogic-jms>
