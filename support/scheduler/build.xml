<?xml version="1.0" encoding="UTF-8"?>

<project basedir="." default="all" name="TimerProcess">

    <description>
        Ant task for compiling the scheduled jobs war and jar
    </description>

    <import file="./../../tools/ant/framework.xml" />

    <property name="project.type.builds.jar" value="true" />
    <property name="project.type.builds.war" value="false" />
    <property name="project.type.requires.compilation" value="true" />

    <!--
      =======================================================================
        Initialise Override
      =======================================================================
      -->   
    <target name="initialise" unless="skip.initialise" depends="framework.initialise">
        <log target="initialise"/>

        <path id="compile.classpath">           
            <path refid="lib.classpath"/>
            <fileset dir="${build.dest.dir}" includes="Framework.jar" />            
         </path>
         
         <filesetlist id="jar.classes.filelist">
         	<fileset dir="${classes.dir}">
         		<include name="**/JavaTask.class" />
         		<include name="**/RemoteTask.class" />
         		<include name="**/TaskStrategy.class" />
         		<include name="**/Stoppable.class" />
         	</fileset>         	
         </filesetlist>

         <filesetlist id="war.classes.fileset">
             <fileset dir="${classes.dir}" />
         </filesetlist>
    </target>

</project>
