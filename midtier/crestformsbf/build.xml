<?xml version="1.0" encoding="UTF-8"?>

<project basedir="." default="all" name="CrestFormsBF">

    <description>
        This project contains the files for the midtier for the production of
        crestformsbf by the application.
    </description>

    <import file="./../../tools/ant/framework.xml" />

    <property name="project.type.controller.bean"      value="marker" />
    <property name="project.type.requires.compilation" value="marker" />

    <!--
      =======================================================================
        Initialise Override
      =======================================================================
      -->
    <target name="initialise" unless="skip.initialise" depends="framework.initialise">
        <log target="initialise"/>

        <!-- Generate xml binding using castor -->

        <property name="schemas.dir" location="${top.level.dir}/metadata/schemas/crestformsbf" />

        <path id="generate.xml.binding.dependencies">
            <fileset dir="${schemas.dir}" includes="**/*.xsd"/>
        </path>

        <path id="generate.xml.binding.schemas">
            <fileset dir="${schemas.dir}">
                <include name="CrestForms.xsd"/>
            </fileset>
        </path>

        <!-- Compile classes using javac -->

        <path id="compile.classpath">
            <path refid="lib.classpath"/>
            <fileset dir="${build.dest.dir}">
                <include name="ResultsController.jar" />
                <include name="ChargeController.jar" />
                <include name="CaseController.jar" />
                <include name="Value.jar" />
                <include name="SysAdminEntities.jar" />
                <include name="Framework.jar" />
                <include name="Config.jar" />
                <include name="ResultsEntities.jar" />
                <include name="Results2Controller.jar" />
                <include name="ResultsCommon.jar" />
                <include name="XhibitEntities.jar" />
                <include name="XhibitValues.jar" />
            </fileset>
        </path>        
    </target>
</project>

