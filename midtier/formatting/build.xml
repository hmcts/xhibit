<?xml version="1.0" encoding="UTF-8"?>

<project basedir="." default="all" name="Formatting">

    <description>
        The midtier formatting code, extracted into its own sub-project.
    </description>

    <import file="./../../tools/ant/framework.xml" />

    <property name="project.type.controller.bean" value="marker" />
    <property name="project.type.requires.compilation" value="marker" />

    <!--
      =======================================================================
        Initialise Override
      =======================================================================
      -->
    <target name="initialise" unless="skip.initialise" depends="framework.initialise">
        <log target="initialise"/>
        <path id="compile.classpath">
            <path refid="lib.classpath"/>
            <fileset dir="${build.dest.dir}">
                <include name="Framework.jar" />
                <include name="Value.jar" />
                <include name="TranslationController.jar" />
                <include name="CppFormattingController.jar" />
                <include name="CppListController.jar" />
				<include name="CppStagingInboundController.jar" />
                <include name="TimerProcess.jar" />
                <include name="XhibitXmlBinding.jar" />
            </fileset>
        </path>
    </target>

</project>