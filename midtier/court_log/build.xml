<?xml version="1.0" encoding="UTF-8"?>

<project basedir="." default="all" name="CourtLog2">

    <description>
        The new court log
    </description>

    <import file="./../../tools/ant/framework.xml" />

    <property name="project.type.controller.bean"      value="marker" />
    <property name="project.type.requires.compilation" value="marker" />

    <!--
      =======================================================================
        Initialise Override
      =======================================================================
      -->
    <target name="initialise" unless="skip.initialise" depends="framework.initialise">
        <log target="initialise"/>        
        <path id="compile.classpath">
            <path refid="lib.classpath"/>
            <fileset dir="${build.dest.dir}">
                <include name="TimerProcess.jar" />
                <include name="Framework.jar" />
                <include name="XhibitEntities.jar" />
                <include name="XhibitValues.jar" />
                <include name="CourtLogCommon.jar" />
            </fileset>
        </path>

        <!-- Include the event helpers in the client jar -->
        <property name="controller.jar.file.client.includes" value="**/*Delegate*.class, **/*Exception.class, **/helpers/event/*.class" />
    </target>

    <!--
      =======================================================================
        Package Override
      =======================================================================
      -->
    <target name="package.controller" unless="skip.package" depends="framework.package.controller">
        <log target="package"/>
        <!-- need to add some additional files to the generated jar files -->
        <jar destfile="${controller.jar.file.no.ejbc}" update="true">
            <fileset dir="${config.dir}" includes="subscriptions/*.xml" />
        </jar>
    </target>

</project>