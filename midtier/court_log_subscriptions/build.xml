<?xml version="1.0" encoding="UTF-8"?>

<project basedir="." default="all" name="ClSubscriptions">

    <description>
        This project contains the files for the midtier for the court_log
        subscriptions.
    </description>

    <import file="./../../tools/ant/framework.xml" />

    <property name="project.type.builds.jar" value="marker"/>
    <property name="project.type.requires.compilation" value="marker"/>

    <!--
      =======================================================================
        Initialise Override
      =======================================================================
      -->
    <target name="initialise" unless="skip.initialise" depends="framework.initialise">
        <log target="initialise"/>

        <!-- Generate Configuration -->

        <property name="schemas.dir" location="${top.level.dir}/support/config/src/config/xml/cjse_integration" />

        <path id="generate.xml.binding.dependencies">
            <fileset dir="${schemas.dir}" includes="**/*.xsd"/>
        </path>

        <path id="generate.xml.binding.schemas">
            <fileset dir="${schemas.dir}">
                <include name="cjse-integration-pilot-entities.xsd"/>
                <include name="cjse-integration-pilot-types.xsd"/>
            </fileset>
        </path>
        
        <!-- Compile Configuration -->

        <path id="compile.classpath">
            <path refid="lib.classpath"/>
            <fileset dir="${build.dest.dir}">
				<include name="Darts.jar" />
                <include name="XhibitDartsController.jar" />
                <include name="CourtLog2Controller.jar" />
                <include name="ChargeController.jar" />
                <include name="Framework.jar" />
                <include name="XhibitValues.jar" />
                <include name="XhibitEntities.jar" />
                <include name="CourtLogCommon.jar" />
                <include name="Value.jar" />
                <include name="ProbationServiceController.jar" />
                <include name="ProbationServiceEntities.jar" />
                <include name="CrLiveStatus.jar" />
                <include name="PublicDisplayCommon.jar" />
                <include name="PublicNoticeController.jar" />
                <include name="HearingScheduleController.jar" />
            </fileset>
        </path>

    </target>
</project>

