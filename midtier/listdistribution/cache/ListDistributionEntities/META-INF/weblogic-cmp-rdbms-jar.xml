            </field-map>
            <field-map>
                <cmp-field>recipientName</cmp-field>
                <dbms-column>RECIPIENT_NAME</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>faxNumber</cmp-field>
                <dbms-column>FAX_NUMBER</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>emailAddress</cmp-field>
                <dbms-column>EMAIL_ADDRESS</dbms-column>
            </field-map>
            <field-map>
