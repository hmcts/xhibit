    <weblogic-rdbms-relation>
        <relation-name>wLLRecipient-documentDistribution</relation-name>
        <weblogic-relationship-role>
            <relationship-role-name>DocumentDistributionRelationshipRole</relationship-role-name>
            <relationship-role-map>
                <foreign-key-table>XHB_DOCUMENT_DISTRIBUTION</foreign-key-table>
                <primary-key-table>XHB_WLL_RECIPIENT</primary-key-table>
                <column-map>
                    <foreign-key-column>WLL_RECIPIENT_ID</foreign-key-column>
                    <key-column>WLL_RECIPIENT_ID</key-column>
                </column-map>
            </relationship-role-map>
        </weblogic-relationship-role>
    </weblogic-rdbms-relation>
    <weblogic-rdbms-relation>
        <relation-name>recipient-documentDistribution</relation-name>
        <weblogic-relationship-role>
            <relationship-role-name>DocumentDistributionRelationshipRole</relationship-role-name>
            <relationship-role-map>
                <foreign-key-table>XHB_DOCUMENT_DISTRIBUTION</foreign-key-table>
                <primary-key-table>XHB_RECIPIENT</primary-key-table>
                <column-map>
                    <foreign-key-column>RECIPIENT_ID</foreign-key-column>
                    <key-column>RECIPIENT_ID</key-column>
                </column-map>
            </relationship-role-map>
        </weblogic-relationship-role>
    </weblogic-rdbms-relation>
</weblogic-rdbms-jar>