            </field-map>
            <field-map>
                <cmp-field>solicitorFirmEmail</cmp-field>
                <dbms-column>SOLICITOR_FIRM_EMAIL</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>createdBy</cmp-field>
                <dbms-column>CREATED_BY</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>lastUpdatedBy</cmp-field>
                <dbms-column>LAST_UPDATED_BY</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>version</cmp-field>
                <dbms-column>VERSION</dbms-column>
            </field-map>
        </table-map>
        <!--<delay-database-insert-until>commit</delay-database-insert-until>-->
        <automatic-key-generation>
            <generator-type>ORACLE</generator-type>
            <generator-name>XHB_WLL_RECIPIENT_SEQ</generator-name>
            <key-cache-size>1</key-cache-size>
        </automatic-key-generation>
    </weblogic-rdbms-bean>
    <weblogic-rdbms-bean>
        <ejb-name>DocumentDistribution</ejb-name>
        <data-source-name>@xhibit.tx.database.jndi@</data-source-name>
        <table-map>
            <table-name>XHB_DOCUMENT_DISTRIBUTION</table-name>
            <field-map>
                <cmp-field>docDistributionId</cmp-field>
                <dbms-column>DOC_DISTRIBUTION_ID</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>distributionType</cmp-field>
                <dbms-column>DISTRIBUTION_TYPE</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>documentType</cmp-field>
                <dbms-column>DOCUMENT_TYPE</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>mimeType</cmp-field>
                <dbms-column>MIME_TYPE</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>courtId</cmp-field>
                <dbms-column>COURT_ID</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>recipientId</cmp-field>
                <dbms-column>RECIPIENT_ID</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>wllRecipientId</cmp-field>
                <dbms-column>WLL_RECIPIENT_ID</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>createdBy</cmp-field>
                <dbms-column>CREATED_BY</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>lastUpdatedBy</cmp-field>
                <dbms-column>LAST_UPDATED_BY</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>version</cmp-field>
                <dbms-column>VERSION</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>usePrefDistType</cmp-field>
                <dbms-column>USE_PREF_DIST_TYPE</dbms-column>
            </field-map>
        </table-map>
        <!--<delay-database-insert-until>commit</delay-database-insert-until>-->
        <automatic-key-generation>
            <generator-type>ORACLE</generator-type>
            <generator-name>XHB_DOCUMENT_DISTRIBUTION_SEQ</generator-name>
            <key-cache-size>1</key-cache-size>
        </automatic-key-generation>
    </weblogic-rdbms-bean>
