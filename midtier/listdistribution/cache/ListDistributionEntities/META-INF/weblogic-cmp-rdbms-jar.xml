        <ejb-name>WLLRecipient</ejb-name>
        <data-source-name>@xhibit.tx.database.jndi@</data-source-name>
        <table-map>
            <table-name>XHB_WLL_RECIPIENT</table-name>
            <field-map>
                <cmp-field>wllRecipientId</cmp-field>
                <dbms-column>WLL_RECIPIENT_ID</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>crestSolicitorFirmId</cmp-field>
                <dbms-column>CREST_SOLICITOR_FIRM_ID</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>courtId</cmp-field>
                <dbms-column>COURT_ID</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>solicitorFirmName</cmp-field>
                <dbms-column>SOLICITOR_FIRM_NAME</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>solictiorFirmAddress</cmp-field>
                <dbms-column>SOLICTIOR_FIRM_ADDRESS</dbms-column>
            </field-map>
            <field-map>
                <cmp-field>solicitorFirmFax</cmp-field>
