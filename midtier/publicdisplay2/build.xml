<?xml version="1.0" encoding="UTF-8"?>

<project basedir="." default="all" name="PublicDisplay2">

    <description>
        The public display re-write sub-project of midtier
    </description>

    <import file="./../../tools/ant/framework.xml" />

    <property name="component.author"   value="Meeraj Kunnumpurath, Rakesh Lakhani, Bob Boothby, Neil Ellis" />

    <property name="project.type.controller.bean"      value="true" />
    <property name="project.type.message.bean"         value="true" />
    <property name="project.type.requires.compilation" value="true" />

    <!--
      =======================================================================
        Initialise Override
      =======================================================================
      -->
    <target name="initialise" unless="skip.initialise" depends="framework.initialise">
        <log target="initialise"/>
        <path id="compile.classpath">            
            <path refid="lib.classpath"/>
            <fileset dir="${build.dest.dir}">
                 <include name="CourtLogCommon.jar"/>
                 <include name="Framework.jar"/>
                 <include name="XhibitEntities.jar"/>
                 <include name="XhibitValues.jar"/>
                 <include name="PublicDisplayCommon.jar"/>
                 <include name="Value.jar"/>
                 <include name="CaseController.jar"/>
                 <include name="CrLiveStatus.jar"/>
				 <include name="CppFormattingController.jar"/>
                <include name="FormattingController.jar" />
				<include name="PublicNoticeController.jar" />

            </fileset>
        </path>

        <!--
            PublicDisplay was written prior to the framework, therefore
            differing conventions were used.  Override where appropriate the
            different properties.
        -->
        <property name="message.jar.file.includes" value="**/Public*Listener.java" />
        <property name="controller.manifest.file"  location="${manifest.dir}/PublicDisplayController.mf" />
        <property name="message.manifest.file"     location="${manifest.dir}/PublicDisplayMessageBeans.mf" />
        <property name="message.jar.file"          location="${lib.build.dir}/PublicDisplayMessageBeans.jar" />
    </target>

    <!--
      =======================================================================
        Release Override
      =======================================================================
      -->
    <target name="release" unless="skip.release" depends="framework.release">
        <log target="release"/>
        <copy todir="${build.dest.dir}">
            <fileset dir="${client.build.dir}" />
        </copy>
    </target>


</project>
