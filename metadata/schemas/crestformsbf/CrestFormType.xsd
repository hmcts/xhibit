<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSPY v5 rel. 2 U (http://www.xmlspy.com) by Neil Entwistle (Electronic Data Systems LTD) -->
<xs:schema targetNamespace="http://www.courtservice.gov.uk/schemas/courtservice/xhibit/crestformsbf" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.courtservice.gov.uk/schemas/courtservice/xhibit/crestformsbf" elementFormDefault="qualified" attributeFormDefault="unqualified">
    <!--      Start of Simple Types -->
    <xs:simpleType name="AppealType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Conviction"/>
            <xs:enumeration value="Sentence"/>
            <xs:enumeration value="ConvictionSentence"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="CaseReferenceType">
        <xs:annotation>
            <xs:documentation>Used to hold CaseType+CaseNumber</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z][0-9]{8}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="CourtHouseTypeCode">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{3,4}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="CourtType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Magistrates"/>
            <xs:enumeration value="Crown"/>
            <xs:enumeration value="Youth"/>
            <xs:enumeration value=""/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="DisposalDurationType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Period"/>
            <xs:enumeration value="Life"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="DisposalTermType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Consecutive"/>
            <xs:enumeration value="Concurrent"/>
            <xs:enumeration value=""/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="VerdictTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Verdict"/>
            <xs:enumeration value="Conviction"/>
            <xs:enumeration value="Other"/>
            <xs:enumeration value=""/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="YesNoType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Yes"/>
            <xs:enumeration value="No"/>
        </xs:restriction>
    </xs:simpleType>
    <!--      Start of Complex Types -->
    <xs:complexType name="AltOffence">
        <xs:annotation>
            <xs:documentation>For plea and Verdict</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="AltOffenceCode" type="xs:string"/>
            <xs:element name="AltOffenceDesc" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="AppealCaseReference">
        <xs:annotation>
            <xs:documentation>Additional info added</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="CaseReference">
                <xs:sequence>
                    <xs:element name="ReasonForAppeal" type="xs:string">
                        <xs:annotation>
                            <xs:documentation>Picked up from case.judgeReasonForAppeal</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element name="CaseTitle" type="xs:string">
                        <xs:annotation>
                            <xs:documentation>Picked up from case.caseTitle</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element name="CaseDesc" type="xs:string">
                        <xs:annotation>
                            <xs:documentation>Picked up from case.case_description</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="BreachChargeStructure">
        <xs:annotation>
            <xs:documentation>Applies to Breach Type Form (E)</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="ChargeStructure">
                <xs:sequence>
                    <xs:element name="Breach" type="BreachStructure" minOccurs="0"/>
                </xs:sequence>
                <xs:attribute name="HOCode" type="xs:int" use="optional">
                    <xs:annotation>
                        <xs:documentation>xhb_charge.ref_system_code_id

Look up ref_system_code_id in ref_system_code and get the code</xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="BreachStructure">
        <xs:sequence>
            <xs:element name="OriginalSentence" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>xhb_breach.originalSentence</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="CommittalAfterBreach" type="YesNoType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>xhb_breach.breachType C=Yes B=No</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="BringBack" type="YesNoType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>xhb_breach.bringback Y/N</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="CourtHouseType" type="CourtType">
                <xs:annotation>
                    <xs:documentation>refCourt</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="CourtHouseCode" type="xs:string">
                <xs:annotation>
                    <xs:documentation>refCourt</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="CourtHouseName" type="xs:string">
                <xs:annotation>
                    <xs:documentation>refCourt</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="OriginalDate" type="xs:date" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>xhb_breach.originalSentenceDate</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="BreachPutDate" type="xs:date" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>xhb_breach.datePut</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Admitted" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>xhb_plea.breach_admitted using the defendant_charge_id</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="CaseReference">
        <xs:sequence>
            <xs:element name="CaseReference" type="CaseReferenceType">
                <xs:annotation>
                    <xs:documentation>doc.getCase  CaseType+CaseNumber</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ChargeStructure">
        <xs:sequence>
            <xs:element name="Offence" type="OffenceStructure" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="IndictmentNumber" type="xs:int" use="optional">
            <xs:annotation>
                <xs:documentation>charge.getCrestChargeSeqNo</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>
    <xs:complexType name="CourtClerkStructure">
        <xs:sequence>
            <xs:element name="ClerkName" type="xs:string">
                <xs:annotation>
                    <xs:documentation>passed in from session - current logged on CourtClerk</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="CourtHouseStructure">
        <xs:sequence>
            <xs:element name="CourtHouseType" type="CourtType"/>
            <xs:element name="CourtHouseCode">
                <xs:complexType>
                    <xs:simpleContent>
                        <xs:extension base="CourtHouseTypeCode">
                            <xs:attribute name="CourtHouseShortName" use="optional">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:pattern value="[A-Z]{3,5}"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:attribute>
                        </xs:extension>
                    </xs:simpleContent>
                </xs:complexType>
            </xs:element>
            <xs:element name="CourtHouseName" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="DefendantStructure">
        <xs:annotation>
            <xs:documentation>doc.getDefendant</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="DefendantID" type="xs:int">
                <xs:annotation>
                    <xs:documentation>defendant.crestDefendantID</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="DefendantNumber" type="xs:int">
                <xs:annotation>
                    <xs:documentation>doc.defendant_number</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="DefendantName" type="PersonNameStructure">
                <xs:annotation>
                    <xs:documentation>defenant.getForename MiddleName Surname</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="DisposalStructure">
        <xs:sequence>
            <xs:element name="DisposalCode" type="xs:string">
                <xs:annotation>
                    <xs:documentation>disposal.getRefDisposalID >> RefDisposal.disposalCode</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="DisposalDesc" type="xs:string">
                <xs:annotation>
                    <xs:documentation>disposal.getRefDisposalID >> RefDisposal.disposalTitle</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="FormBFText" type="xs:string">
                <xs:annotation>
                    <xs:documentation>text to be displayed for disposal</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="IsMagistrateCourt" type="YesNoType">
                <xs:annotation>
                    <xs:documentation>disposal2.courtType - used for Crest Form F</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="VerdictCode" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>verdict code for unrelated dosposals</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="VerdictDesc" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>verdict description for unrelated dosposals</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Variations" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Variation" type="DisposalStructure" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="MiscAppealChargeStructure">
        <xs:annotation>
            <xs:documentation>Applies to Appeal Type Forms (FMisc)</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:extension base="ChargeStructure"/>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="OffenceStructure">
        <xs:sequence>
            <xs:element name="OffenceNo" type="xs:int">
                <xs:annotation>
                    <xs:documentation>offence.crestOffenceSeqNo</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="OffenceCode" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>offence.refOffenceId.offemceCode</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="OffenceDesc" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>offence.refOffenceId.offemceDesc</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="AppealType" type="AppealType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Type F forms only - doo.getAppealAgainstType</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Verdict" type="VerdictStructure" minOccurs="0"/>
            <xs:element name="Plea" type="PleaStructure" minOccurs="0"/>
            <xs:element name="VCOFlag" type="VerdictTypeType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>doo.vcoflag</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="VCODate" type="xs:date" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>doo.vcodate</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Disposal" type="DisposalStructure" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="PeriodStructure">
        <xs:sequence>
            <xs:element name="Years" type="xs:string">
                <xs:annotation>
                    <xs:documentation>disposalId >> disposalReference.referenceValue - years</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Months" type="xs:string">
                <xs:annotation>
                    <xs:documentation>disposalId >> disposalReference.referenceValue - months</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Days" type="xs:string">
                <xs:annotation>
                    <xs:documentation>disposalId >> disposalReference.referenceValue - days</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="PersonNameStructure">
        <xs:sequence>
            <xs:element name="Forename" type="xs:string" minOccurs="0"/>
            <xs:element name="MiddleName" type="xs:string" minOccurs="0"/>
            <xs:element name="Surname" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="PleaStructure">
        <xs:sequence>
            <xs:element name="PleaCode" type="xs:string">
                <xs:annotation>
                    <xs:documentation>plea.refPleaID >> refSystemCodeId refSystemCode.code</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="PleaDesc" type="xs:string">
                <xs:annotation>
                    <xs:documentation>plea.refPleaID >> refSystemCodeId refSystemCode.de_code</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="PleaFreeText" type="xs:string">
                <xs:annotation>
                    <xs:documentation>plea.other_plea_text</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ArraignmentDate" type="xs:date" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>plea.arraignmentDate</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="BreachAdmitted" type="YesNoType">
                <xs:annotation>
                    <xs:documentation>plea.breachAdmitted Y=true otherwise false</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="AlternativeOffence" type="AltOffence" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>verdict.alt_ref_offence_id >> xhb_ref_offence</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ResultType">
        <xs:annotation>
            <xs:documentation>Used to hold Misc Appeal Details</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Result" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>case level verdict code - verdict desc</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ResultDate" type="xs:date" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>case level verdict date</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="HearingDate" type="xs:date" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>hearing.hearing_start_date</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="HearingDuration" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>hearing.lastcalculatedduration</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="TransferCourt" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>case.ccc_trans_to_ref_court_id</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="VerdictStructure">
        <xs:sequence>
            <xs:element name="VerdictCode" type="xs:string">
                <xs:annotation>
                    <xs:documentation>verdict.refVerdictID RefSystemCode.RefSystemCodeID code</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="VerdictDesc" type="xs:string">
                <xs:annotation>
                    <xs:documentation>verdict.refVerdictID RefSystemCode.RefSystemCodeID desc</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="VerdictOtherText" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>verdict.other_verdict_text</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="JurorsAssenting" type="xs:string">
                <xs:annotation>
                    <xs:documentation>verdict.jurorsAssenting</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="JurorsDissenting" type="xs:string">
                <xs:annotation>
                    <xs:documentation>verdict.jurors.dissenting</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="AlternativeOffence" type="AltOffence" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>verdict.alt_ref_offence_id >> xhb_ref_offence</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <!--Crest Forms B-F Inc FMisc-->
    <xs:complexType name="CrestFormBType">
        <xs:sequence>
            <xs:element name="Case" type="CaseReference"/>
            <xs:element name="CourtClerk" type="CourtClerkStructure"/>
            <xs:element name="Defendant" type="DefendantStructure"/>
            <xs:element name="Charges" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Charge" type="ChargeStructure" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="UnrelatedDisposals" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Disposal" type="DisposalStructure" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="TICS" type="xs:int">
                <xs:annotation>
                    <xs:documentation>Taken Into Consideration</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="CrestFormCType">
        <xs:sequence>
            <xs:element name="Case" type="CaseReference"/>
            <xs:element name="CourtClerk" type="CourtClerkStructure"/>
            <xs:element name="Defendant" type="DefendantStructure"/>
            <xs:element name="Charges" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Charge" type="ChargeStructure" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="CrestFormDType">
        <xs:sequence>
            <xs:element name="Case" type="CaseReference"/>
            <xs:element name="CourtClerk" type="CourtClerkStructure"/>
            <xs:element name="Defendant" type="DefendantStructure"/>
            <xs:element name="Charges" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Charge" type="ChargeStructure" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="UnrelatedDisposals" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Disposal" type="DisposalStructure" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="TICS" type="xs:int">
                <xs:annotation>
                    <xs:documentation>Taken Into Consideration</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="CrestFormEType">
        <xs:sequence>
            <xs:element name="Case" type="CaseReference"/>
            <xs:element name="CourtClerk" type="CourtClerkStructure"/>
            <xs:element name="Defendant" type="DefendantStructure"/>
            <xs:element name="BreachCharges" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="BreachCharge" type="BreachChargeStructure" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="CrestFormFType">
        <xs:annotation>
            <xs:documentation>hardcode appealtype Criminal (fo)</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="AppealCase" type="AppealCaseReference"/>
            <xs:element name="CourtClerk" type="CourtClerkStructure"/>
            <xs:element name="Defendant" type="DefendantStructure"/>
            <xs:element name="Charges" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Charge" type="ChargeStructure" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="UnrelatedDisposals" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Disposal" type="DisposalStructure" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="CrestFormFMiscType">
        <xs:annotation>
            <xs:documentation>hardcode appealtype Misc (fo)</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="AppealCase" type="AppealCaseReference"/>
            <xs:element name="CourtClerk" type="CourtClerkStructure"/>
            <xs:element name="Defendant" type="DefendantStructure"/>
            <xs:element name="MiscAppealCharges" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Result" type="ResultType"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="UnrelatedDisposals" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Disposal" type="DisposalStructure" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>
