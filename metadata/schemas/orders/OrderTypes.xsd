		<xs:sequence>
			<xs:element name="AssociatedCase" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="CaseNumberType">
							<xs:attributeGroup ref="ConditionAttributeGroup"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ChargedWithStructure">
		<xs:sequence>
			<xs:element name="ChargedWith" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CrownCourtCommittalStructure">
		<xs:sequence>
			<xs:element name="CommittalDate" type="xs:date"/>
			<xs:element name="CommittingCourt" type="XHIBITCourtHouseStructure"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="BreachStructure">
		<xs:sequence>
			<xs:element name="ConvictingCourt">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="OriginatingCourtStructure"/>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="OriginatingCourt">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="OriginatingCourtStructure">
							<xs:sequence>
								<xs:element name="OriginalOrderType" type="xs:string"/>
							</xs:sequence>
						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="BreachCourt">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="OriginatingCourtStructure">
							<xs:sequence>
								<xs:element name="SentToCrownCourt" type="xs:string"/>
							</xs:sequence>
							<xs:attribute name="breachCourtOption" type="xs:boolean"/>
						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
