			<xs:enumeration value="BailOrder"/>
			<xs:enumeration value="BenchWarrant"/>
			<xs:enumeration value="CPOrder"/>
			<xs:enumeration value="CPROrder"/>
			<xs:enumeration value="YOIOrder"/>
			<xs:enumeration value="CROrder"/>
			<xs:enumeration value="ImprisonmentOrder"/>
			<xs:enumeration value="RemandOrder"/>
			<xs:enumeration value="COOrder_pre_LASBO"/>
			<xs:enumeration value="SUSOrder_pre_LASBO"/>
			<xs:enumeration value="ImprisonmentOrder5035C_pre_LASBO"/>
			<xs:enumeration value="YoungOffendersOrder5044C_pre_LASBO"/>
			<xs:enumeration value="YoungOffendersOrder5044D_pre_LASBO"/>
			<xs:enumeration value="BWAOrder"/>
			<xs:enumeration value="BWCOrder"/>
			<xs:enumeration value="ImprisonmentOrder5035C"/>
			<xs:enumeration value="SUSOrder"/>
			<xs:enumeration value="COOrder"/>
			<xs:enumeration value="YoungOffendersOrder5044C"/>
			<xs:enumeration value="YoungOffendersOrder5044D"/>
			<xs:enumeration value="BailOrderBCase"/>
			<xs:enumeration value="MonetaryOrder"/>
			<xs:enumeration value="D20"/>
			<xs:enumeration value="ReleaseFromPrisonOrder"/>
			<xs:enumeration value="ActionConditionalDischargeOrder"/>
			<xs:enumeration value="NoticeOfDefermentSentenceOrder"/>
			<xs:enumeration value="NoticeBreachSuspendedSentence"/>
			<xs:enumeration value="BreachSuspendedSentenceOrder"/>
			<xs:enumeration value="BreachConditionalDischargeOrder"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrderTypeType">
		<xs:restriction base="xs:string"/>
	</xs:simpleType>
	<xs:simpleType name="PNCnumberType">
		<xs:restriction base="xs:string">
			<xs:minLength value="12"/>
			<xs:maxLength value="12"/>
			<xs:pattern value="[0-9]{4}[0-9]{7}[A-Za-z0-9]"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PrisonerIDtype">
		<xs:restriction base="xs:string"/>
	</xs:simpleType>
	<xs:simpleType name="RemandType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Indicted"/>
			<xs:enumeration value="Convicted"/>
		</xs:restriction>
		<!-- RemandTypeType -->
	</xs:simpleType>
	<xs:simpleType name="ResidenceStatusType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="resident"/>
			<xs:enumeration value="non-resident"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SentenceType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Detention"/>
			<xs:enumeration value="Imprisonment"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SubjectTypeType">
