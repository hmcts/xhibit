			<xs:enumeration value="Magistrates Court"/>
			<xs:enumeration value="Crown Court"/>
			<xs:enumeration value="Youth Court"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ChargeTypeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="indictment"/>
			<xs:enumeration value="summary"/>
			<xs:enumeration value="breach"/>
			<xs:enumeration value="committal"/>
			<xs:enumeration value="appeal"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Section91TermTypeType">
		<xs:restriction base="xs:string">
