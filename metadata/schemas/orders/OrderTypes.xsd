	<xs:complexType name="JudiciaryStructure">
		<xs:sequence>
			<xs:element name="Judge">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="apd:CitizenNameStructure">
							<xs:sequence>
								<xs:element name="CRESTjudgeID" type="xs:int" minOccurs="0"/>
							</xs:sequence>
						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="Justice" minOccurs="0" maxOccurs="4">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="apd:CitizenNameStructure">
							<xs:sequence minOccurs="0">
								<xs:element name="CRESTjusticeID" type="xs:int" minOccurs="0"/>
							</xs:sequence>
						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="StartDate" type="xs:date" minOccurs="0"/>
			<xs:element name="EndDate" type="xs:date" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
