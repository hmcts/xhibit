			<xs:enumeration value="Unconditional"/>
			<xs:enumeration value="SubjectToBailOrder"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="XHIBITOrderedType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="SubjectToConditions"/>
			<xs:enumeration value="CompliedWithConditions"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="XHIBITCountType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="AllCounts"/>
			<xs:enumeration value="SpecificCounts"/>
		</xs:restriction>
	</xs:simpleType>
