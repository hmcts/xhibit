	<xs:complexType name="XHIBITNoteSection">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attributeGroup ref="OptionalConditionAttributeGroup"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:complexType name="OtherReasonsForRemandStructure">
		<xs:sequence>
			<xs:element name="WelfareReason" type="XHIBITNoteSection"/>
			<xs:element name="OwnProtectionReason" type="XHIBITNoteSection"/>
			<xs:element name="LackOfPlacementReason" type="XHIBITNoteSection"/>
			<xs:element name="BailISSNotAvailableReason" type="XHIBITNoteSection"/>
			<xs:element name="BailInadequateReason" type="XHIBITNoteSection"/>
		</xs:sequence>		
		<xs:attributeGroup ref="ConditionAttributeGroup"/>
	</xs:complexType>
	<xs:complexType name="ReasonsForRemandStructure">	
		<xs:sequence>
			<xs:element name="SeriousnessForRemand">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="SeriousnessOfOffence"/>
						<xs:element name="LikelyConviction" type="xs:boolean"/>
					</xs:sequence>
					<xs:attributeGroup ref="ConditionAttributeGroup"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="RemandHistory">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="HistoryForRemand"/>
						<xs:element name="LikelyCustodialSentence" type="xs:boolean"/>
					</xs:sequence>
					<xs:attributeGroup ref="ConditionAttributeGroup"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="NecessityCondition">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="RiskOfHarm" type="xs:boolean"/>
					</xs:sequence>
					<xs:attributeGroup ref="ConditionAttributeGroup"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="OtherReasonsForRemand" type="OtherReasonsForRemandStructure"/>
		</xs:sequence>		
		<xs:attributeGroup ref="ConditionAttributeGroup"/>
	</xs:complexType>
	<xs:complexType name="XHIBITRiskFactorsStructure">
		<xs:sequence>
			<xs:element name="RiskText" type="xs:string"/>
		</xs:sequence>		
	</xs:complexType>
	<xs:complexType name="AttachmentTypeType">
		<xs:attributeGroup ref="ConditionAttributeGroup"/>
	</xs:complexType>
