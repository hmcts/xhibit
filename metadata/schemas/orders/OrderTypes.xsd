			<xs:extension base="xs:string">
				<xs:attributeGroup ref="OptionalConditionAttributeGroup"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:complexType name="AddressStructure">
		<xs:choice>
			<xs:element name="UKAddress" type="apd:UKAddressStructure"/>
