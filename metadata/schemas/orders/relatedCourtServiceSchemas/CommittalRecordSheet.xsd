<xsd:schema targetNamespace="http://www.courtservice.gov.uk/schemas/courtservice" xmlns="http://www.courtservice.gov.uk/schemas/courtservice" xmlns:cs="http://www.courtservice.gov.uk/schemas/courtservice" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.1">
	<xsd:include schemaLocation="CourtService.xsd"/>
	<xsd:annotation>
		<xsd:appinfo xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcq="http://purl.org/terms/" xmlns:gms="http://www.govtalk.gov.uk/CM/gms">
			<dc:creator>Court Service</dc:creator>
			<dc:date>2003-02-21</dc:date>
			<dc:identifier>CommittalRecordSheet</dc:identifier>
			<dc:language>en</dc:language>
			<dc:rights>
				<dcq:copyright>Crown Copyright 2002</dcq:copyright>
				<gms:SecurityClassification>Unclassified</gms:SecurityClassification>
			</dc:rights>
			<dc:subject>Crown Court Committal Record Sheet</dc:subject>
		</xsd:appinfo>
	</xsd:annotation>
	<xsd:complexType name="CommittalRecordSheetStructure">
		<xsd:sequence>
			<xsd:element name="DocumentID" type="DocumentIDstructure"/>
			<xsd:element name="RecordSheetHeader" type="RecordSheetHeaderStructure"/>
			<xsd:element name="DefenceAdvocates" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="DefenceAdvocate" type="DefenceStructure" maxOccurs="unbounded"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="Prosection" type="ProsecutionStructure" minOccurs="0"/>
			<xsd:element name="CourtReportingFirms" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="CourtReportingFirm" type="CourtReportingStructure" maxOccurs="unbounded"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="Judiciaries" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="Judiciary" type="JudiciaryStructure" maxOccurs="unbounded"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="BailStatusOnCommittal" type="BailStatusType" minOccurs="0"/>
			<xsd:element name="BailStatusAtStartOfHearing" type="BailStatusType" minOccurs="0"/>
			<xsd:element name="BailStatusPutBackforSentence" type="BailStatusType" minOccurs="0"/>
			<xsd:element name="Hearings" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="Hearing" type="HearingTypeStructure" maxOccurs="unbounded"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="SentencePostponedDate" type="xsd:date" minOccurs="0"/>
			<xsd:element name="SentenceOrOrderDate" type="xsd:date" minOccurs="0"/>
			<xsd:element name="LinkedCases" type="LinkedCasesStructure" minOccurs="0"/>
			<xsd:element name="SentencesAndOrders" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="SentenceOrOrder" maxOccurs="unbounded">
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="OffenceNumber" type="xsd:string"/>
									<xsd:element name="OffenceDescription" type="xsd:string"/>
									<xsd:element name="Term" type="xsd:duration"/>
									<xsd:element name="TermType" type="TermTypeType"/>
									<xsd:element name="ConcurrentCases" type="LinkedCasesStructure" minOccurs="0"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="CrownCourtDecision" type="xsd:string" minOccurs="0"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OffencesOrOrdersBreached" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="OffenceOrBreach" maxOccurs="unbounded">
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="OffenceNumber" type="xsd:string"/>
									<xsd:element name="OriginatingCourt" type="OriginatingCourtStructure" minOccurs="0"/>
									<xsd:element name="Description" type="xsd:string"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="Term" type="xsd:duration"/>
						<xsd:element name="TermType" type="TermTypeType"/>
						<xsd:element name="OtherOrders" minOccurs="0">
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="Order" type="xsd:string" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="NewSentenceOrOrder">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="Term" type="xsd:duration"/>
						<xsd:element name="TermType" type="TermTypeType"/>
						<xsd:element name="OtherOrders" minOccurs="0">
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="Order" type="xsd:string" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="TotalSentence">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="Term" type="xsd:duration"/>
						<xsd:element name="TermType" type="TermTypeType"/>
						<xsd:element name="OtherOrders" minOccurs="0">
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="Order" type="xsd:string" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="CommittalRecordSheet" type="CommittalRecordSheetStructure"/>
</xsd:schema>
