<xsd:schema targetNamespace="http://www.courtservice.gov.uk/schemas/courtservice" xmlns:apd="http://www.govtalk.gov.uk/people/AddressAndPersonalDetails" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.courtservice.gov.uk/schemas/courtservice" xmlns:cs="http://www.courtservice.gov.uk/schemas/courtservice" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.1">
	<xsd:include schemaLocation="CourtService.xsd"/>
	<xsd:annotation>
		<xsd:appinfo xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcq="http://purl.org/terms/" xmlns:gms="http://www.govtalk.gov.uk/CM/gms">
			<dc:creator>Court Service</dc:creator>
			<dc:date>2003-02-21</dc:date>
			<dc:identifier>WitnessWarrantOrder</dc:identifier>
			<dc:language>en</dc:language>
			<dc:rights>
				<dcq:copyright>Crown Copyright 2002</dcq:copyright>
				<gms:SecurityClassification>Unclassified</gms:SecurityClassification>
			</dc:rights>
			<dc:subject>Crown Court Witness Warrant Order</dc:subject>
		</xsd:appinfo>
	</xsd:annotation>
	<xsd:complexType name="WitnessWarrantOrderStructure">
		<xsd:sequence>
			<xsd:element name="DocumentID" type="DocumentIDstructure"/>
			<xsd:element name="OrderHeader" type="CourtOrderHeaderStructure"/>
			<xsd:element name="Attendance">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:enumeration value="Summoned"/>
						<xsd:enumeration value="Ordered"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="CaseType">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:enumeration value="Trial"/>
						<xsd:enumeration value="Appeal"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="Failures">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="Failure" type="xsd:string" maxOccurs="unbounded"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="Conditions">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="Condition" type="xsd:string" maxOccurs="unbounded"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="BringWitnessTo">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:enumeration value="Crown Court"/>
						<xsd:enumeration value="Magistrates Court"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="SumOf" type="MoneyType"/>
			<xsd:element name="NumberOfSureties" type="xsd:positiveInteger"/>
			<xsd:element name="SumOfSureties" type="MoneyType"/>
			<xsd:element name="EachCheckBox" type="apd:YesNoType"/>
			<xsd:element name="AppearanceCourt" type="CourtAppearanceStructure"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="WitnessWarrantOrder" type="WitnessWarrantOrderStructure"/>
</xsd:schema>
