<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:ord="http://www.courtservice.gov.uk/schemas/courtservice/xhibit/orders" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.courtservice.gov.uk/schemas/courtservice/xhibit/orders" targetNamespace="http://www.courtservice.gov.uk/schemas/courtservice/xhibit/orders" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xsd:include schemaLocation="OrderTypes.xsd"/>
	<xsd:complexType name="ActionConditionalDischargeOrderStructure">
		<xsd:sequence>
			<xsd:element name="OrderHeader" type="XHIBITCourtOrderHeaderStructure"/>
			<xsd:element name="Addressee">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="CourtHouseDetails" type="XHIBITCourtHouseStructure"/>
 					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="DateOfOrder" type="xsd:date" />
 			<xsd:element name="ConvictionDate" type="xsd:date" />
			<xsd:element name="CourtOrdered" type="CourtOrderedStructure" />
			<xsd:element name="AssociatedCases" type="AssociatedCaseStructure" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="ActionConditionalDischargeOrder" type="ord:ActionConditionalDischargeOrderStructure">
		<xsd:annotation>
			<xsd:documentation>Schema V1.0 (30/11/2015)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
</xsd:schema>
