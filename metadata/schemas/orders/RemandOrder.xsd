<xs:schema xmlns:ord="http://www.courtservice.gov.uk/schemas/courtservice/xhibit/orders" xmlns="http://www.courtservice.gov.uk/schemas/courtservice/xhibit/orders" xmlns:apd="http://www.govtalk.gov.uk/people/AddressAndPersonalDetails" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.courtservice.gov.uk/schemas/courtservice/xhibit/orders" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="OrderTypes.xsd"/>
	<xs:import namespace="http://www.govtalk.gov.uk/people/AddressAndPersonalDetails" schemaLocation="courtService/apd.xsd"/>
	<xs:complexType name="RemandOrderStructure">
		<xs:annotation>
			<xs:documentation>Schema V4.1 (08/06/2005)</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OrderHeader" type="XHIBITCourtOrderHeaderStructure"/>
			<xs:element name="RemandOrderType" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="RemandOrdType">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:enumeration value="localauthority"/>
									<xs:enumeration value="youthdetention"/>
									<xs:enumeration value="standard"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="LADesignatedLocalAuthority" type="xs:string"/>
						<xs:element name="YDDesignatedLocalAuthority" type="xs:string"/>
						<xs:element name="RequirementsOnLocalAuthority">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attributeGroup ref="ConditionAttributeGroup"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="ConditionsOnDefendant">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attributeGroup ref="ConditionAttributeGroup"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="CustodyLocation" type="xs:string"/>
			<xs:element name="ReportDetails">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attributeGroup ref="ConditionAttributeGroup"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="NextAppearance" type="XHIBITCourtAppearanceStructure"/>
			<xs:element name="ReasonsForRemand">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="ReasonsForRemandStructure">
							<xs:attributeGroup ref="ConditionAttributeGroup"/>
						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="RemandReason">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="CommitSent">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:enumeration value="committed"/>
									<xs:enumeration value="sent"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="IsBefore">
							<xs:complexType>
								<xs:attributeGroup ref="ConditionAttributeGroup"/>
							</xs:complexType>
						</xs:element>
						<xs:sequence>
							<xs:element name="CrownCourt">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="CourtHouse" type="XHIBITCourtHouseStructure"/>
										<xs:element name="Date" type="apd:DateType"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="VoluntaryBillOfIndictment">
								<xs:annotation>
									<xs:documentation>Altered from date because of Castor bug. Should go back when Castor can cope with complex extensions of xs:date.</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attributeGroup ref="ConditionAttributeGroup"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="CertificateOfTransfer">
								<xs:annotation>
									<xs:documentation>Altered from date because of Castor bug. Should go back when Castor can cope with complex extensions of xs:date.</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attributeGroup ref="ConditionAttributeGroup"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="AppealAgainstBailGranted">
								<xs:complexType>
									<xs:attributeGroup ref="ConditionAttributeGroup"/>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:sequence>
					<xs:attributeGroup ref="ConditionAttributeGroup"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="RemandType" type="RemandType"/>
			<xs:element name="AdditionalInfo">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attributeGroup ref="ConditionAttributeGroup"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="ChargedWith" minOccurs="0">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attributeGroup ref="ConditionAttributeGroup"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="AssociatedCases" type="AssociatedCaseStructure" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
