<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.courtservice.gov.uk/schemas/courtservice/xhibit"
    xmlns="http://www.courtservice.gov.uk/schemas/courtservice/xhibit"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    elementFormDefault="qualified"
    attributeFormDefault="unqualified"
    version="2.2"
    id="ListDistributionCourtService">

    <xsd:include schemaLocation="ListDistributionAddressTypes-v1.xsd"/>
    <xsd:include schemaLocation="ListDistributionPersonalDetailsTypes-v1.xsd"/>

    <xsd:simpleType name="ASnumberType">
        <xsd:restriction base="xsd:string">
            <xsd:minLength value="20"/>
            <xsd:maxLength value="20"/>
            <xsd:pattern value="[0-9]{2}[A-Za-z0-9]{4}[0-9]{2}[0-9]{11}[A-Za-z0-9]"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="BailStatusType">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="On bail"/>
            <xsd:enumeration value="On remand"/>
            <xsd:enumeration value="In care"/>
            <xsd:enumeration value="In custody"/>
            <xsd:enumeration value="Not applicable"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="CaseLinkRefType">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="[A-Z][0-9]{8}( FIX)?"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="CaseNumberType">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="[A-Z][0-9]{8}"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="CourtHouseCodeType">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="[0-9]{3,4}"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="CourtType">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="Crown Court"/>
            <xsd:enumeration value="Magistrates Court"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="CRnumberType">
        <xsd:restriction base="xsd:string">
            <xsd:minLength value="23"/>
            <xsd:maxLength value="23"/>
            <xsd:pattern value="[0-9]{2}[A-Za-z0-9]{4}[0-9]{2}[0-9]{11}[A-Za-z0-9][0-9]{3}"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="HearingTypeType">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="[A-Z][A-Z][A-Z]"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="MethodOfInstigationType">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="Committal"/>
            <xsd:enumeration value="Sending"/>
            <xsd:enumeration value="Execution"/>
            <xsd:enumeration value="Transfer"/>
            <xsd:enumeration value="Transfer certificated"/>
            <xsd:enumeration value="Voluntary bill"/>
            <xsd:enumeration value="Rehearing ordered"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="PNCnumberType">
        <xsd:restriction base="xsd:string">
            <xsd:minLength value="12"/>
            <xsd:maxLength value="12"/>
            <xsd:pattern value="[0-9]{4}[0-9]{7}[A-Za-z0-9]"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="ProsecutingAuthorityType">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="Crown Prosecution Service"/>
            <xsd:enumeration value="Customs and Excise"/>
            <xsd:enumeration value="Department of Trade and Industry"/>
            <xsd:enumeration value="Inland Revenue"/>
            <xsd:enumeration value="Other Prosecutor"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="PrisonerIDtype">
        <xsd:restriction base="xsd:string"/>
    </xsd:simpleType>
    <xsd:simpleType name="TermTypeType">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="Before"/>
            <xsd:enumeration value="Concurrent"/>
            <xsd:enumeration value="Consecutive"/>
        </xsd:restriction>
    </xsd:simpleType>
    <xsd:simpleType name="URNtype">
        <xsd:restriction base="xsd:string"/>
    </xsd:simpleType>

    <xsd:complexType name="AdvocateStructure">
        <xsd:complexContent>
            <xsd:extension base="PersonStructure">
                <xsd:sequence>
                    <xsd:element name="StartDate" type="xsd:date" minOccurs="0"/>
                    <xsd:element name="EndDate" type="xsd:date" minOccurs="0"/>
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>

    <xsd:complexType name="ChargeStructure">
        <xsd:sequence>
            <xsd:element name="CRN" type="CRnumberType" minOccurs="0"/>
            <xsd:element name="CRESTchargeID" type="xsd:string" minOccurs="0"/>
            <xsd:element name="CaseNumber" type="CaseNumberType" minOccurs="0"/>
            <xsd:element name="OffenceStatement" type="xsd:string"/>
            <xsd:element name="OffenceDate" type="xsd:date" minOccurs="0"/>
            <xsd:element name="ArraignmentDate" type="xsd:date" minOccurs="0"/>
            <xsd:element name="ConvictionDate" type="xsd:date" minOccurs="0"/>
            <xsd:element name="OffenceParticulars" type="xsd:string" minOccurs="0"/>
            <xsd:element name="CRESToffenceNumber" type="xsd:string" minOccurs="0"/>
            <xsd:element name="Plea" type="xsd:string" minOccurs="0"/>
            <xsd:element name="Verdict" type="xsd:string" minOccurs="0"/>
            <xsd:element name="Disposals" minOccurs="0">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="Disposal" type="xsd:string" maxOccurs="unbounded"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="SentenceTerm" type="xsd:duration" minOccurs="0"/>
            <xsd:element name="TermType" type="TermTypeType" minOccurs="0"/>
            <xsd:element name="ForLife" type="YesNoType" default="yes" minOccurs="0"/>
        </xsd:sequence>
        <xsd:attribute name="ChargeType" type="xsd:string" use="optional">
            <xsd:annotation>
                <xsd:documentation>
					Charge type must be one of: indictment, summary, breach, committal, appeal.
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
        <xsd:attribute name="IndictmentNumber" type="xsd:int" use="optional"/>
        <xsd:attribute name="IndictmentCountNumber" type="xsd:int" use="required"/>
        <xsd:attribute name="CJSoffenceCode" type="xsd:string" use="optional"/>
        <xsd:attribute name="PNCoffenceCode" type="xsd:string" use="optional"/>
        <xsd:attribute name="HOoffenceCode" type="xsd:string" use="optional"/>
        <xsd:attribute name="Life" type="YesNoType" use="optional"/>
    </xsd:complexType>

    <xsd:complexType name="CourtHouseStructure">
        <xsd:sequence>
            <xsd:element name="CourtHouseType" type="CourtType"/>
            <xsd:element name="CourtHouseCode">
                <xsd:complexType>
                    <xsd:simpleContent>
                        <xsd:extension base="CourtHouseCodeType">
                            <xsd:attribute name="CourtHouseShortName" use="optional">
                                <xsd:simpleType>
                                    <xsd:restriction base="xsd:string">
                                        <xsd:pattern value="[A-Z]{3,5}"/>
                                    </xsd:restriction>
                                </xsd:simpleType>
                            </xsd:attribute>
                        </xsd:extension>
                    </xsd:simpleContent>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="CourtHouseName" type="xsd:string"/>
            <xsd:element name="CourtHouseAddress" type="UKPostalAddressStructure" minOccurs="0"/>
            <xsd:element name="CourtHouseDX" type="xsd:string" minOccurs="0"/>
            <xsd:element name="CourtHouseTelephone" type="TelephoneNumberType" minOccurs="0"/>
            <xsd:element name="CourtHouseFax" type="TelephoneNumberType" minOccurs="0"/>
            <xsd:element name="Description" type="xsd:string" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>Used to hold High and Combined</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

	<xsd:complexType name="DocumentIDstructure">
		<xsd:sequence>
			<xsd:element name="DocumentName" type="xsd:string"/>
			<xsd:element name="UniqueID" type="xsd:string"/>
			<xsd:element name="DocumentType" type="xsd:string"/>
			<xsd:element name="TimeStamp" type="xsd:dateTime" minOccurs="0"/>
			<xsd:element name="Version" type="xsd:string" minOccurs="0"/>
			<xsd:element name="SecurityClassification" type="xsd:string" minOccurs="0"/>
			<xsd:element name="SellByDate" type="xsd:date" minOccurs="0"/>
			<xsd:element name="XSLstylesheetURL" type="xsd:string" minOccurs="0"/>
			<xsd:element name="DocumentInformation" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Used to descibe version changes</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>

    <xsd:complexType name="HearingTypeStructure">
        <xsd:sequence>
            <xsd:element name="HearingDescription" type="xsd:string"/>
            <xsd:element name="HearingDate" type="xsd:date" minOccurs="0"/>
            <xsd:element name="HearingEndDate" type="xsd:date" minOccurs="0"/>
            <xsd:element name="ListNote" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
        <xsd:attribute name="HearingType" type="HearingTypeType"/>
    </xsd:complexType>

    <xsd:complexType name="JudiciaryStructure">
        <xsd:sequence>
            <xsd:element name="Judge">
                <xsd:complexType>
                    <xsd:complexContent>
                        <xsd:extension base="CitizenNameStructure">
                            <xsd:sequence>
                                <xsd:element name="CRESTjudgeID" type="xsd:int" minOccurs="0"/>
                            </xsd:sequence>
                        </xsd:extension>
                    </xsd:complexContent>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="Justice" minOccurs="0" maxOccurs="4">
                <xsd:complexType>
                    <xsd:complexContent>
                        <xsd:extension base="CitizenNameStructure">
                            <xsd:sequence minOccurs="0">
                                <xsd:element name="CRESTjusticeID" type="xsd:int" minOccurs="0"/>
                            </xsd:sequence>
                        </xsd:extension>
                    </xsd:complexContent>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="StartDate" type="xsd:date" minOccurs="0"/>
            <xsd:element name="EndDate" type="xsd:date" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="LinkedCasesStructure">
        <xsd:sequence>
            <xsd:element name="CaseNumber" type="CaseLinkRefType" maxOccurs="unbounded"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="ListHeaderStructure">
        <xsd:sequence>
            <xsd:element name="ListCategory" default="Criminal">
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:enumeration value="Combined"/>
                        <xsd:enumeration value="Criminal"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="StartDate" type="xsd:date"/>
            <xsd:element name="EndDate" type="xsd:date" minOccurs="0"/>
            <xsd:element name="Version" type="xsd:string"/>
            <xsd:element name="CRESTprintRef" type="xsd:string" minOccurs="0"/>
            <xsd:element name="PublishedTime" type="xsd:dateTime"/>
            <xsd:element name="CRESTlistID" type="xsd:int" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="OrganisationStructure">
        <xsd:sequence>
            <xsd:element name="OrganisationCode" type="xsd:string" minOccurs="0"/>
            <xsd:element name="OrganisationName" type="xsd:string"/>
            <xsd:element name="OrganisationAddress" type="UKPostalAddressStructure" minOccurs="0"/>
            <xsd:element name="OrganisationDX" type="xsd:string" minOccurs="0"/>
            <xsd:element name="ContactDetails" type="CitizenContactDetailsStructure" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

	<xsd:complexType name="PartyStructure">
		<xsd:choice>
			<xsd:element name="Person" type="PersonStructure"/>
			<xsd:element name="Organisation" type="OrganisationStructure"/>
		</xsd:choice>
	</xsd:complexType>

    <xsd:complexType name="PersonalDetailsStructure">
        <xsd:sequence>
            <xsd:element name="Name" type="CitizenNameStructure" minOccurs="0"/>
            <xsd:element name="MaskedName" type="xsd:string" minOccurs="0"/>
            <xsd:element name="IsMasked" type="YesNoType"/>
            <xsd:element name="DateOfBirth" type="CitizenBirthDateStructure" minOccurs="0"/>
            <xsd:element name="Sex" type="SexType" minOccurs="0"/>
            <xsd:element name="Address" type="UKPostalAddressStructure" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="PersonStructure">
        <xsd:sequence>
            <xsd:element name="PersonalDetails" type="PersonalDetailsStructure">
                <xsd:annotation>
                    <xsd:documentation>PersonalDetails must include at least one of  Name or MaskedName (it may include both)</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="ContactDetails" type="CitizenContactDetailsStructure" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="PrisonLocationStructure">
        <xsd:sequence>
            <xsd:element name="Location" type="xsd:string"/>
        </xsd:sequence>
        <xsd:attribute name="PrisonID" type="xsd:string"/>
    </xsd:complexType>

    <xsd:complexType name="ProsecutionStructure">
        <xsd:sequence>
            <xsd:element name="Advocate" type="AdvocateStructure" minOccurs="0" maxOccurs="unbounded"/>
            <xsd:element name="ProsecutingReference" type="xsd:string" minOccurs="0"/>
            <xsd:element name="ProsecutingOrganisation" type="OrganisationStructure" minOccurs="0"/>
        </xsd:sequence>
        <xsd:attribute name="ProsecutingAuthority" type="ProsecutingAuthorityType"/>
    </xsd:complexType>

    <xsd:complexType name="SolicitorStructure">
        <xsd:sequence>
            <xsd:element name="Party" type="PartyStructure"/>
            <xsd:element name="StartDate" type="xsd:date" minOccurs="0"/>
            <xsd:element name="EndDate" type="xsd:date" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

</xsd:schema>
