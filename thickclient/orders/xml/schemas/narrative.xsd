					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="If" type="NarrativeMainBodyIfType"/>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="NarrativeIfType">
		<xs:sequence>
			<xs:element name="Condition" type="NarrativeIfCondition"/>
			<xs:element name="Body" type="NarrativeContainerType"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="NarrativeMainBodyIfType">
		<xs:sequence>
			<xs:element name="Condition">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="NarrativeIfCondition"/>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="Body" type="NarrativeMainBodyType"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="NarrativeIfCondition">
		<xs:restriction base="xs:string">
			<xs:enumeration value="ConditionalBail"/>
			<xs:enumeration value="ReportIndicator"/>
			<xs:enumeration value="RemandCommitted"/>
			<xs:enumeration value="RemandIsBefore"/>
			<xs:enumeration value="ChapterIII"/>
			<xs:enumeration value="ExtendedSentence"/>
			<xs:enumeration value="ReturnOfDefendant"/>
			<xs:enumeration value="DiscretionaryLife"/>
			<xs:enumeration value="Section86"/>
			<xs:enumeration value="AdditionalNotes"/>
			<xs:enumeration value="DeportationSection"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
