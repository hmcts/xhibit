              <xs:element name="H1" type="NarrativeHeadingType"/>
              -->
			</xs:choice>
			<xs:choice>
				<xs:element name="P">
					<xs:complexType mixed="true">
						<xs:complexContent mixed="true">
							<xs:extension base="NarrativeContainerType"/>
						</xs:complexContent>
					</xs:complexType>
				</xs:element>
				<xs:element name="Table">
					<xs:complexType mixed="true">
						<xs:sequence maxOccurs="unbounded">
							<xs:element name="TR">
								<xs:complexType>
									<xs:sequence maxOccurs="unbounded">
										<xs:element name="TD" type="NarrativeContainerType"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
