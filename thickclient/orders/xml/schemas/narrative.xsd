		<xs:choice minOccurs="0" maxOccurs="unbounded"/>
	</xs:group>
	<xs:group name="NarrativeAtomicValueTagGroup">
		<xs:choice maxOccurs="unbounded"/>
	</xs:group>
	<xs:complexType name="NarrativeValueTagType" mixed="true"/>
	<xs:complexType name="NarrativeMainBodyType">
		<xs:choice maxOccurs="unbounded">
			<xs:element name="Section">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Label" type="NarrativeContainerType"/>
