<xsd:schema targetNamespace="http://www.courtservice.gov.uk/schemas/courtservice" xmlns="http://www.courtservice.gov.uk/schemas/courtservice" xmlns:apd="http://www.govtalk.gov.uk/people/AddressAndPersonalDetails" xmlns:cs="http://www.courtservice.gov.uk/schemas/courtservice" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.1">
	<xsd:include schemaLocation="CourtService.xsd"/>
	<xsd:annotation>
		<xsd:appinfo xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcq="http://purl.org/terms/" xmlns:gms="http://www.govtalk.gov.uk/CM/gms">
			<dc:creator>Court Service</dc:creator>
			<dc:date>2003-02-21</dc:date>
			<dc:identifier>RemandOrder</dc:identifier>
			<dc:language>en</dc:language>
			<dc:rights>
				<dcq:copyright>Crown Copyright 2002</dcq:copyright>
				<gms:SecurityClassification>Unclassified</gms:SecurityClassification>
			</dc:rights>
			<dc:subject>Crown Court Remand Order</dc:subject>
		</xsd:appinfo>
	</xsd:annotation>
	<xsd:complexType name="RemandOrderStructure">
		<xsd:sequence>
			<xsd:element name="DocumentID" type="DocumentIDstructure"/>
			<xsd:element name="OrderHeader" type="CourtOrderHeaderStructure"/>
			<xsd:element name="CustodyLocation" type="xsd:string" minOccurs="0"/>
			<xsd:element name="ForReportOn" type="xsd:string"/>
			<xsd:element name="NextAppearance" type="CourtAppearanceStructure"/>
			<xsd:element name="ReasonsForRemand" type="ReasonsForRemandStructure"/>
			<xsd:element name="RemandReason" type="RemandReasonStructure"/>
			<xsd:element name="RemandType" type="RemandTypeType"/>
			<xsd:element name="AdditionalNotes" type="xsd:string" minOccurs="0"/>
			<xsd:element name="AssociatedCases" type="AssociatedCaseStructure" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="RemandOrder" type="RemandOrderStructure"/>
</xsd:schema>
