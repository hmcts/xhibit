<xsd:schema targetNamespace="http://www.courtservice.gov.uk/schemas/courtservice" xmlns="http://www.courtservice.gov.uk/schemas/courtservice" xmlns:cs="http://www.courtservice.gov.uk/schemas/courtservice" xmlns:apd="http://www.govtalk.gov.uk/people/AddressAndPersonalDetails" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.1">
	<xsd:include schemaLocation="CourtService.xsd"/>
	<xsd:annotation>
		<xsd:appinfo xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcq="http://purl.org/terms/" xmlns:gms="http://www.govtalk.gov.uk/CM/gms">
			<dc:creator>Court Service</dc:creator>
			<dc:date>2003-02-21</dc:date>
			<dc:identifier>Indictment</dc:identifier>
			<dc:language>en</dc:language>
			<dc:rights>
				<dcq:copyright>Crown Copyright 2002</dcq:copyright>
				<gms:SecurityClassification>Unclassified</gms:SecurityClassification>
			</dc:rights>
			<dc:subject>Crown Court Indictment</dc:subject>
		</xsd:appinfo>
	</xsd:annotation>
	<xsd:complexType name="IndictmentStructure">
		<xsd:sequence>
			<xsd:element name="DocumentID" type="DocumentIDstructure"/>
			<xsd:element name="IssuingCourtHouse" type="CourtHouseStructure"/>
			<xsd:element name="Cases">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="CaseNumber" type="CaseNumberType" maxOccurs="unbounded"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="DateReceived" type="xsd:date" minOccurs="0"/>
			<xsd:element name="Signed" type="YesNoType"/>
			<xsd:element name="DateSigned" type="xsd:date" minOccurs="0"/>
			<xsd:element name="SigningOfficer" type="PersonalDetailsStructure" minOccurs="0"/>
			<xsd:element name="Defendants">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="Defendant" type="DefendantStructure" maxOccurs="unbounded"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="JoinderIndictment" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="DateJoined" type="xsd:date"/>
						<xsd:element name="PreferedByJudge" type="cs:JudiciaryStructure"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute name="IsJoinderIndictment" type="YesNoType" use="required"/>
	</xsd:complexType>
	<xsd:element name="Indictment" type="IndictmentStructure"/>
</xsd:schema>
