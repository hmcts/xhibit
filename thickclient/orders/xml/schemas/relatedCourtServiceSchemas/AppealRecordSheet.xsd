<xsd:schema targetNamespace="http://www.courtservice.gov.uk/schemas/courtservice" xmlns:apd="http://www.govtalk.gov.uk/people/AddressAndPersonalDetails" xmlns:cs="http://www.courtservice.gov.uk/schemas/courtservice" xmlns="http://www.courtservice.gov.uk/schemas/courtservice" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.1">
	<xsd:include schemaLocation="CourtService.xsd"/>
	<xsd:annotation>
		<xsd:appinfo xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcq="http://purl.org/terms/" xmlns:gms="http://www.govtalk.gov.uk/CM/gms">
			<dc:creator>Court Service</dc:creator>
			<dc:date>2003-02-21</dc:date>
			<dc:identifier>AppealRecordSheet</dc:identifier>
			<dc:language>en</dc:language>
			<dc:rights>
				<dcq:copyright>Crown Copyright 2002</dcq:copyright>
				<gms:SecurityClassification>Unclassified</gms:SecurityClassification>
			</dc:rights>
			<dc:subject>Crown Court Appeal Record Sheet</dc:subject>
		</xsd:appinfo>
	</xsd:annotation>
	<xsd:complexType name="AppealRecordSheetStructure">
		<xsd:sequence>
			<xsd:element name="DocumentID" type="DocumentIDstructure"/>
			<xsd:element name="RecordSheetHeader" type="RecordSheetHeaderStructure"/>
			<xsd:element name="OriginalSentenceOrOrderDate" type="xsd:date" minOccurs="0"/>
			<xsd:element name="AppellantAdvocates" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="AppellantAdvocate" type="AdvocateStructure" maxOccurs="unbounded"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="Respondents" type="ProsecutionStructure" minOccurs="0"/>
			<xsd:element name="CourtReportingFirms" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="CourtReportingFirm" type="CourtReportingStructure" maxOccurs="unbounded"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="Judiciaries" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="Judiciary" type="JudiciaryStructure" maxOccurs="unbounded"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="BailStatusWhenAppealLodged" type="BailStatusType" minOccurs="0"/>
			<xsd:element name="BailStatusAtStartOfHearing" type="BailStatusType" minOccurs="0"/>
			<xsd:element name="Hearings" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="Hearing" type="HearingTypeStructure" maxOccurs="unbounded"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="DecisionGivenDate" type="xsd:date" minOccurs="0"/>
			<xsd:element name="SentenceOrOrderDate" type="xsd:date" minOccurs="0"/>
			<xsd:element name="Offences">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="Offence" maxOccurs="unbounded">
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="OffenceNumber" type="xsd:string" minOccurs="0"/>
									<xsd:element name="Offence" type="xsd:string"/>
									<xsd:element name="AppealType" type="AppealTypeType"/>
									<xsd:element name="AppealResult" type="xsd:string"/>
									<xsd:element name="OriginalSentenceOrOrder" type="xsd:string"/>
									<xsd:element name="CrownCourtDecision" type="xsd:string" minOccurs="0"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="ReasonsForDecision" type="xsd:string" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="AppealRecordSheet" type="AppealRecordSheetStructure"/>
</xsd:schema>
