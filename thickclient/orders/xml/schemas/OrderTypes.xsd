<xs:schema xmlns="http://www.courtservice.gov.uk/schemas/courtservice/xhibit/orders" xmlns:apd="http://www.govtalk.gov.uk/people/AddressAndPersonalDetails" xmlns:bs7666="http://www.govtalk.gov.uk/people/bs7666" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.courtservice.gov.uk/schemas/courtservice/xhibit/orders" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:import namespace="http://www.govtalk.gov.uk/people/AddressAndPersonalDetails" schemaLocation="courtService/apd.xsd"/>
	<xs:import namespace="http://www.govtalk.gov.uk/people/bs7666" schemaLocation="courtService/BS7666-v1.xsd"/>
	<!--
    -
    - Start of Simple Type Definition
    -
    -->
	<xs:attributeGroup name="ConditionAttributeGroup">
		<xs:attribute name="selected" type="xs:boolean" use="optional" default="false"/>
	</xs:attributeGroup>
	<xs:simpleType name="OrganisationNameType">
		<xs:restriction base="apd:RestrictedStringType">
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ASnumberType">
		<xs:restriction base="xs:string">
			<xs:minLength value="20"/>
			<xs:maxLength value="20"/>
			<xs:pattern value="[0-9]{2}[A-Za-z0-9]{4}[0-9]{2}[0-9]{11}[A-Za-z0-9]"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="BailDecisionType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="conditional"/>
			<xs:enumeration value="unconditional"/>
			<xs:enumeration value="refused"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="BailStatusType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="On bail"/>
			<xs:enumeration value="On remand"/>
			<xs:enumeration value="In care"/>
			<xs:enumeration value="In custody"/>
			<xs:enumeration value="Not applicable"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CaseNumberType">
		<xs:restriction base="xs:string">
			<xs:pattern value="[A-Z][0-9]{8}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CourtHouseCodeType">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{3,4}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CRnumberType">
		<xs:restriction base="xs:string">
			<xs:minLength value="23"/>
			<xs:maxLength value="23"/>
			<xs:pattern value="[0-9]{2}[A-Za-z0-9]{4}[0-9]{2}[0-9]{11}[A-Za-z0-9][0-9]{3}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CourtType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="magistrates court"/>
			<xs:enumeration value="crown court"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DateQualifierType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="before"/>
			<xs:enumeration value="on or before"/>
			<xs:enumeration value="on"/>
			<xs:enumeration value="on or after"/>
			<xs:enumeration value="after"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MoneyType">
		<xs:restriction base="xs:decimal">
			<xs:pattern value="[0-9]{1,8}(\d[0-9]{1,2})?"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DetentionTypeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Detention"/>
			<xs:enumeration value="Imprisonment"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrderTypeType">
		<xs:restriction base="xs:string"/>
	</xs:simpleType>
	<xs:simpleType name="PNCnumberType">
		<xs:restriction base="xs:string">
			<xs:minLength value="12"/>
			<xs:maxLength value="12"/>
			<xs:pattern value="[0-9]{4}[0-9]{7}[A-Za-z0-9]"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PrisonerIDtype">
		<xs:restriction base="xs:string"/>
	</xs:simpleType>
	<xs:simpleType name="RemandType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Indicted"/>
			<xs:enumeration value="Convicted"/>
		</xs:restriction>
		<!-- RemandTypeType -->
	</xs:simpleType>
	<xs:simpleType name="SentenceType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="detention"/>
			<xs:enumeration value="imprisonment"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SubjectTypeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Defendant"/>
			<xs:enumeration value="Appellant"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TermTypeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="before"/>
			<xs:enumeration value="concurrent"/>
			<xs:enumeration value="consecutive"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="URNtype">
		<xs:restriction base="xs:string"/>
	</xs:simpleType>
	<!--
    -
    - Start of Complex Type Definition
    -
    -->
	<!--ADDED FOR CCN400 - START -->
	<xs:complexType name="DeportationStructure">
		<xs:sequence>
			<xs:element name="Reason" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<!-- ADDED FOR CCN400 - END -->
	<xs:complexType name="AddressStructure">
		<xs:choice>
			<xs:element name="UKAddress" type="apd:UKAddressStructure"/>
			<xs:element name="InternationalAddress" type="apd:InternationalAddressStructure"/>
			<!-- WDF: 24/02/03 - Changed names as CASTOR does not like names to be same as type -->
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PersonalDetailsStructure">
		<xs:sequence>
			<xs:element name="Name" type="apd:CitizenNameStructure"/>
			<xs:element name="DateOfBirth" type="apd:CitizenBirthDateStructure" minOccurs="0"/>
			<xs:element name="Sex" type="apd:SexType" minOccurs="0"/>
			<xs:element name="Address" type="apd:UKPostalAddressStructure" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PrisonLocationStructure">
		<xs:sequence>
			<xs:element name="Location" type="xs:string"/>
		</xs:sequence>
		<xs:attribute name="PrisonID" type="xs:string"/>
	</xs:complexType>
	<xs:complexType name="ChargeStructure">
		<xs:sequence>
			<xs:element name="CRN" type="CRnumberType" minOccurs="0"/>
			<xs:element name="CaseNumber" type="CaseNumberType" minOccurs="0"/>
			<xs:element name="OffenceStatement" type="xs:string"/>
			<xs:element name="OffenceDate" type="xs:date" minOccurs="0"/>
			<xs:element name="ArraignmentDate" type="xs:date" minOccurs="0"/>
			<xs:element name="OffenceParticulars" type="xs:string" minOccurs="0"/>
			<xs:element name="CRESToffenceNumber" type="xs:string" minOccurs="0"/>
			<xs:element name="Plea" type="xs:string" minOccurs="0"/>
			<xs:element name="Verdict" type="xs:string" minOccurs="0"/>
			<xs:element name="DisposalDescription" type="xs:string" minOccurs="0"/>
			<xs:element name="SentenceTerm" type="xs:duration" minOccurs="0"/>
			<xs:element name="TermType" type="TermTypeType" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="IndictmentNumber" type="xs:int" use="optional"/>
		<xs:attribute name="IndictmentCountNumber" type="xs:int" use="required"/>
		<xs:attribute name="CJSoffenceCode" type="xs:string" use="optional"/>
		<xs:attribute name="PNCoffenceCode" type="xs:string" use="optional"/>
		<xs:attribute name="HOoffenceCode" type="xs:string" use="optional"/>
	</xs:complexType>
	<xs:complexType name="MonetaryValueType">
		<xs:sequence>
			<xs:element name="Amount" type="xs:decimal"/>
			<xs:element name="Currency">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="EURO"/>
						<xs:enumeration value="GBP"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AdvocateStructure">
		<xs:complexContent>
			<xs:extension base="PersonStructure">
				<xs:sequence>
					<xs:element name="StartDate" type="xs:date" minOccurs="0"/>
					<xs:element name="EndDate" type="xs:date" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PersonStructure">
		<xs:sequence>
			<xs:element name="PersonalDetails" type="PersonalDetailsStructure">
				<xs:annotation>
					<xs:documentation>PersonalDetails must include at least one of  Name or MaskedName (it may include both)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ContactDetails" type="apd:CitizenContactDetailsStructure" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ConditionStructure">
		<xs:sequence>
			<xs:element name="Description" type="xs:string"/>
			<xs:element name="Period" type="xs:duration" minOccurs="0"/>
			<xs:element name="Date" type="xs:date" minOccurs="0"/>
			<xs:element name="Surety" type="MoneyType" minOccurs="0"/>
			<xs:element name="Security" type="MoneyType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrganisationDetailsStructure">
		<xs:sequence>
			<xs:element name="OrganisationName" type="OrganisationNameType"/>
			<xs:element name="OrganisationAddress" type="AddressStructure"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SolicitorStructure">
		<xs:sequence>
			<xs:element name="Party" type="PartyStructure"/>
			<xs:element name="StartDate" type="xs:date" minOccurs="0"/>
			<xs:element name="EndDate" type="xs:date" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DefenceStructure">
		<xs:sequence>
			<xs:element name="Solicitor" type="SolicitorStructure" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Advocate" type="AdvocateStructure" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CourtHouseStructure">
		<xs:sequence>
			<xs:element name="CourtHouseType" type="CourtType"/>
			<xs:element name="CourtHouseCode">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="CourtHouseCodeType">
							<xs:attribute name="CourtHouseShortName" use="optional">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:pattern value="[A-Z]{5}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:attribute>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="CourtHouseName" type="xs:string"/>
			<xs:element name="CourtHouseAddress" type="apd:UKPostalAddressStructure" minOccurs="0"/>
			<xs:element name="CourtHouseDX" type="xs:string" minOccurs="0"/>
			<xs:element name="CourtHouseTelephone" type="apd:TelephoneNumberType" minOccurs="0"/>
			<xs:element name="CourtHouseFax" type="apd:TelephoneNumberType" minOccurs="0"/>
			<xs:element name="Description" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Used to hold High and Combined</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OriginatingCourtStructure">
		<xs:sequence>
			<xs:element name="Date" type="xs:date"/>
			<xs:element name="CourtHouse" type="CourtHouseStructure"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AssociatedCaseStructure">
		<xs:sequence>
			<xs:element name="AssociatedCase" maxOccurs="unbounded">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="CaseNumberType">
							<xs:attributeGroup ref="ConditionAttributeGroup"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CrownCourtCommittalStructure">
		<xs:sequence>
			<xs:element name="CommittalDate" type="xs:date"/>
			<xs:element name="CommittingCourt" type="CourtHouseStructure"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="BreachStructure">
		<xs:sequence>
			<xs:element name="OriginatingCourt">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="OriginatingCourtStructure">
							<xs:sequence>
								<xs:element name="OriginalOrderType" type="xs:string"/>
							</xs:sequence>
						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="BreachCourt">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="OriginatingCourtStructure">
							<xs:sequence>
								<xs:element name="SentToCrownCourt" type="xs:string"/>
							</xs:sequence>
							<xs:attribute name="breachCourtOption" type="xs:boolean"/>
						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DefendantStructure">
		<xs:complexContent>
			<xs:extension base="PersonStructure">
				<xs:sequence>
					<xs:element name="ASNs" minOccurs="0">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="ASN" type="ASnumberType" maxOccurs="unbounded"/>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element name="CRESTdefendantID" type="xs:int" minOccurs="0"/>
					<xs:element name="PNCnumber" type="PNCnumberType" minOccurs="0"/>
					<xs:element name="URN" type="URNtype" minOccurs="0"/>
					<xs:element name="CROnumber" type="xs:string" minOccurs="0"/>
					<xs:element name="MagistratesCourtRefNumber" type="xs:string" minOccurs="0"/>
					<xs:element name="PrisonerID" type="PrisonerIDtype" minOccurs="0"/>
					<xs:element name="PrisonLocation" type="PrisonLocationStructure" minOccurs="0"/>
					<xs:element name="CustodyStatus" type="BailStatusType" minOccurs="0"/>
					<xs:element name="Counsel" type="DefenceStructure" minOccurs="0" maxOccurs="unbounded"/>
					<xs:element name="Charges" minOccurs="0">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="Charge" type="ChargeStructure" maxOccurs="unbounded"/>
							</xs:sequence>
							<xs:attribute name="NumberOfCharges" type="xs:integer" use="optional"/>
						</xs:complexType>
					</xs:element>
					<xs:element name="AdditionalNotes" type="xs:string" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="JudiciaryStructure">
		<xs:sequence>
			<xs:element name="Judge">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="apd:CitizenNameStructure">
							<xs:sequence>
								<xs:element name="CRESTjudgeID" type="xs:int" minOccurs="0"/>
							</xs:sequence>
						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="Justice" minOccurs="0" maxOccurs="4">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="apd:CitizenNameStructure">
							<xs:sequence minOccurs="0">
								<xs:element name="CRESTjusticeID" type="xs:int" minOccurs="0"/>
							</xs:sequence>
						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="StartDate" type="xs:date" minOccurs="0"/>
			<xs:element name="EndDate" type="xs:date" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrganisationStructure">
		<xs:sequence>
			<xs:element name="OrganisationCode" type="xs:string" minOccurs="0"/>
			<xs:element name="OrganisationName" type="xs:string"/>
			<xs:element name="OrganisationAddress" type="apd:UKPostalAddressStructure" minOccurs="0"/>
			<xs:element name="ContactDetails" type="apd:CitizenContactDetailsStructure" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PartyStructure">
		<xs:choice>
			<xs:element name="Person" type="PersonStructure"/>
			<xs:element name="Organisation" type="OrganisationStructure"/>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="XHIBITCourtAppearanceStructure">
		<xs:sequence>
			<xs:element name="AppearanceCourt" type="CourtHouseStructure"/>
			<xs:element name="AppearanceDateTime">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="AppearanceDate" type="xs:date"/>
						<xs:element name="AppearanceTime" type="xs:time"/>
					</xs:sequence>
					<xs:attributeGroup ref="ConditionAttributeGroup"/>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="XHIBITPeriodStructure">
		<xs:sequence>
			<xs:element name="Years" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:short">
						<xs:minInclusive value="0"/>
						<xs:maxInclusive value="99"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Months" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:short">
						<xs:minInclusive value="0"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Days" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:short">
						<xs:minInclusive value="0"/>
						<xs:maxInclusive value="400"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="XHIBITCourtOrderHeaderStructure">
		<xs:sequence>
			<xs:element name="OrderType" type="OrderTypeType"/>
			<xs:element name="CourtHouse" type="CourtHouseStructure"/>
			<xs:element name="Judiciary" type="JudiciaryStructure" minOccurs="0"/>
			<xs:element name="CaseNumber" type="CaseNumberType"/>
			<xs:element name="SubjectType" type="SubjectTypeType" minOccurs="0"/>
			<xs:element name="Defendant" type="DefendantStructure"/>
			<xs:element name="OrderDate" type="xs:date"/>
			<xs:element name="SignedBy">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="CourtOfficer">
							<xs:complexType>
								<xs:complexContent>
									<xs:extension base="apd:CitizenNameStructure">
										<xs:attributeGroup ref="ConditionAttributeGroup"/>
									</xs:extension>
								</xs:complexContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="Judiciary">
							<xs:complexType>
								<xs:complexContent>
									<xs:extension base="JudiciaryStructure">
										<xs:attributeGroup ref="ConditionAttributeGroup"/>
									</xs:extension>
								</xs:complexContent>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="SignedDate" type="xs:date"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="XHIBITCustodialSentenceStructure">
		<xs:sequence>
			<xs:element name="TermType">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="TermTypeType">
							<xs:attributeGroup ref="ConditionAttributeGroup"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="Term" type="XHIBITPeriodStructure"/>
			<xs:element name="ExtendedSentence">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="ExtensionPeriod" type="XHIBITPeriodStructure"/>
						<xs:element name="SentenceType">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:enumeration value="consecutive"/>
									<xs:enumeration value="concurrent"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="Section44" minOccurs="0">
							<xs:complexType>
								<xs:attributeGroup ref="ConditionAttributeGroup"/>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attributeGroup ref="ConditionAttributeGroup"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="ImprisonmentType">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="life"/>
						<xs:enumeration value="section9394"/>
						<xs:enumeration value="hmpleasure"/>
						<xs:enumeration value="section91"/>
						<xs:enumeration value="period"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DetentionOrImprisonment" type="DetentionTypeType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="XHIBITReturnToImprisonmentStructure">
		<xs:annotation>
			<xs:documentation>Changed to fit XHIBIT requirements</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OffenceDate">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:date">
							<xs:attribute name="Qualifier" type="DateQualifierType"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="SentencingCourt" type="OriginatingCourtStructure"/>
			<xs:element name="ReturnPeriod">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="PeriodInMonths" type="xs:short"/>
						<xs:element name="Max116" default="yes">
							<xs:simpleType>
								<xs:restriction base="apd:YesNoType"/>
							</xs:simpleType>
						</xs:element>
						<!-- WDF: 24/02/03 - Rewritten as CASTOR doesnt like it this way ho, hum! -->
						<!--
            <xs:element name="Max116" type="apd:YesNoType" default="yes"/>   
            -->
					</xs:sequence>
					<xs:attribute name="DetentionType" type="DetentionTypeType"/>
					<xs:attribute name="TermType" type="TermTypeType"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="TotalPeriodOfReturn">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:short">
							<xs:attributeGroup ref="ConditionAttributeGroup"/>
							<xs:attribute name="IncludesNewOffenceTerm" type="apd:YesNoType"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="XHIBITCommunityOrderStructure">
		<xs:sequence>
			<xs:element name="OrderHeader" type="XHIBITCourtOrderHeaderStructure"/>
			<xs:element name="AddressOption">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="AddressIs"/>
						<xs:enumeration value="AddressWillBe"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CommittingCourt">
				<xs:complexType>
					<xs:complexContent>
