						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="OriginalOrderRevoked">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="BreachCourt" type="apd:YesNoType" default="yes"/>
						<xs:element name="CurrentCourt" type="apd:YesNoType" default="yes"/>
					</xs:sequence>
					<xs:attributeGroup ref="ConditionAttributeGroup"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="FailedToComply">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="apd:YesNoType"/>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="AfterHearingFrom">
