								<xs:simpleContent>
									<xs:extension base="xs:int">
										<xs:attribute name="TermType" type="TermTypeType"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="Period" type="XHIBITPeriodStructure" minOccurs="0"/>
