			<xs:element name="RehabilitationPeriod" type="XHIBITPeriodStructure"/>
			<xs:element name="Conditions">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Condition" type="ConditionStructure" maxOccurs="unbounded"/>
					</xs:sequence>
					<xs:attributeGroup ref="ConditionAttributeGroup"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="AssociatedCases" type="AssociatedCaseStructure"/>
			<xs:element name="AdditionalNotes" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
