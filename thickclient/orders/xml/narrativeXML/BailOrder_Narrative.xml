<?xml version="1.0" encoding="UTF-8"?>
<nar:Narrative xmlns:nar="http://www.courtservice.gov.uk/schemas/courtservice/xhibit/orders/narrative">
    <nar:Header>Text</nar:Header>
    <nar:Body>
        <nar:Section>
            <nar:Label/>
            <nar:Body>
                <nar:H1>Bail granted <nar:BailGrantedType/> record of decision
					</nar:H1>
            </nar:Body>
        </nar:Section>
        <nar:Section>
            <nar:Label>
                <nar:Line>Part 1</nar:Line>
                <nar:Line>The <nar:AppellantDefendant/>
                </nar:Line>
            </nar:Label>
            <nar:Body>
                <nar:Table>
                    <nar:TR>
                        <nar:TD>
                            <nar:Line>
                                <nar:DefendantFullName/>
                            </nar:Line>
                            <nar:Line>of: <nar:DefendantAddress/>
                            </nar:Line>
                            <nar:Line>applied to this court for bail.</nar:Line>
                        </nar:TD>
                        <nar:TD>
                            <nar:Line>Date of Birth</nar:Line>
                            <nar:Line>
                                <nar:DefendantDOB/>
                            </nar:Line>
                        </nar:TD>
                    </nar:TR>
                </nar:Table>
            </nar:Body>
        </nar:Section>
        <nar:Section>
            <nar:Label>
                <nar:Line>Part 2</nar:Line>
                <nar:Line>The decision and</nar:Line>
                <nar:Line>conditions</nar:Line>
            </nar:Label>
            <nar:Body>
                <nar:P>The Court considered the application under the Bail Act 1976 on: <nar:OrderDate/>
                </nar:P>
                <nar:P>Bail was granted <nar:BailGrantedType/>.</nar:P>
                <nar:If>
                    <nar:Condition>ConditionalBail</nar:Condition>
                    <nar:Body>
                        <nar:PreConditions/>
                        <nar:PostConditions/>
                    </nar:Body>
                </nar:If>
            </nar:Body>
        </nar:Section>
        <nar:If>
            <nar:Condition>ConditionalBail</nar:Condition>
            <nar:Body>
                <nar:Section>
                    <nar:Label>
                        <nar:Line>Part 3</nar:Line>
                        <nar:Line>Reason(s) for imposing </nar:Line>
                        <nar:Line> the above conditions</nar:Line>
                    </nar:Label>
                    <nar:Body>
                        <nar:Table>
                            <nar:TR>
                                <nar:TD>
                                    <nar:Line>
                                        <nar:Reasons/>
                                    </nar:Line>
                                </nar:TD>
                            </nar:TR>
                        </nar:Table>
                    </nar:Body>
                </nar:Section>
            </nar:Body>
        </nar:If>
        <nar:Section>
            <nar:Label>
                <nar:Line>Part 4</nar:Line>
                <nar:Line>The next appearance</nar:Line>
            </nar:Label>
            <nar:Body>
                <nar:Line>The <nar:AppellantDefendant/> shall appear on <nar:NextAppearanceDate>a date and at a time to be notified</nar:NextAppearanceDate>
				before the <nar:NextAppearanceCourtType/> sitting at: <nar:NextAppearanceCourtHouseName/> or any other place that may be notified, there to surrender to custody.</nar:Line>
                <nar:P/>
                <nar:P>
                    <nar:List>
                        <nar:ListItem>If you do not surrender to custody you will commit an offence.</nar:ListItem>
                        <nar:ListItem>You must comply with the conditions in Part 2 while you are on bail.</nar:ListItem>
                    </nar:List>
                </nar:P>
                <nar:P>If you do not, or if it seems likely that you will not, you may  be remanded in custody.</nar:P>
            </nar:Body>
        </nar:Section>
        <nar:Section>
            <nar:Label/>
            <nar:Body>
                <nar:AssociatedCases/>
            </nar:Body>
        </nar:Section>
    </nar:Body>
    <nar:Footer>Text</nar:Footer>
</nar:Narrative>
