	 			</section>
				<section name="OperationalPeriod" switchLabel="Operational period of the order extended" label="" value="OperationPeriod" switchable="true" ref="//ord:Order/ord:OrderData/*/ord:OrderEffective/ord:OperationPeriod/@selected" selectedValue="true" unselectedValue="false">	
 					<durationdate name="durationdate" dayattribute="true" weekattribute="true" monthattribute="true" yearattribute="true" 
