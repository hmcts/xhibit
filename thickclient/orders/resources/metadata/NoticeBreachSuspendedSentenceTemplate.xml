<?xml version="1.0" encoding="UTF-8"?>
<template>
	 <form>
		<translationsection name="translation" label="" switchLabel="Welsh Translation Required" switchable="true" borderLabel="" borderRaised="true" ref="//ord:Order/ord:OrderData/*/ord:OrderHeader/ord:WelshTranslation" selectedValue="yes" unselectedValue="no">
		</translationsection>
		<section name="Addresse" label="" switchLabel="" borderLabel="Addressee">
