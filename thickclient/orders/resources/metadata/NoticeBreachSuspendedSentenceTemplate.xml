			<textarea name="subsequentOffences" ref="/ord:Order/ord:OrderData/*/ord:SubsequentOffences" label="" rows="5" cols="45" maxlength="1000"/>
		</section>
	    <section name="OrderEffectiveSelection" label="" switchLabel="" borderLabel="Order of this Court">
				<section name="TermNBSS" label="" switchLabel="Term" borderLabel="" borderRaised="false" switchable="true" ref="//ord:Order/ord:OrderData/*/ord:OrderEffective/ord:TermNBSS/@selected" selectedValue="true" unselectedValue="false">
					<choice name="OrderEffectiveChoice" label="" ref="/ord:Order/ord:OrderData/*/ord:OrderEffective/ord:OrderEffectiveType">
						<option name="SuspendedSentenceOriginalTerm" label="Order to take effect with original term unaltered" value="SuspendedSentenceOriginalTerm">			 
						</option>
						<option name="SuspendedSentenceSubstitute" label="Order to take effect substituting a lesser term of " value="SuspendedSentenceSubstitute">				 
							<durationdate name="durationdate" dayattribute="true" weekattribute="true" monthattribute="true" yearattribute="true" 
							label="" defaultrequired="false" defaultdurationvalue="12" ref="/" ref1="//ord:Order/ord:OrderData/*/ord:OrderEffective/ord:TermNBSS/ord:SuspendedSentenceSubstitute"/>
						</option>
					</choice>
				</section>
	 			<section name="Fine" label="" switchLabel="Fine:"  switchable="true" ref="//ord:Order/ord:OrderData/*/ord:OrderEffective/ord:FineValue/@selected" selectedValue="true" unselectedValue="false">	
 					 <currency name="fineValue" label="" signLength="3" length="8" minVal="0" maxLength="10" required="false" type="float" ref="//ord:Order/ord:OrderData/*/ord:OrderEffective/ord:FineValue"/>
			 	</section>
				<section name="CommunityRequirement" switchLabel="More onerous community requirement(s) imposed" label="" value="CommunityRequirement" switchable="true" ref="//ord:Order/ord:OrderData/*/ord:OrderEffective/ord:CommunityReq/@selected"  selectedValue="true" unselectedValue="false">	
					<textarea name="communityReq" ref="/ord:Order/ord:OrderData/*/ord:OrderEffective/ord:CommunityReq" label="" rows="8" cols="35" maxlength="1000"/>
				</section>
				<section name="SupervisionPeriod" switchLabel="Supervision period of the order extended" label="" value="SupervisionalPeriod" switchable="true" ref="//ord:Order/ord:OrderData/*/ord:OrderEffective/ord:SupervisionalPeriod/@selected" selectedValue="true" unselectedValue="false">	
					<durationdate name="durationdate" dayattribute="true" weekattribute="true" monthattribute="true" yearattribute="true" 
