<template>
	<form>
		<translationsection name="translation" label="" switchLabel="Welsh Translation Required" switchable="true" borderLabel="" borderRaised="true" ref="//ord:Order/ord:OrderData/*/ord:OrderHeader/ord:WelshTranslation" selectedValue="yes" unselectedValue="no">
		</translationsection>
		<!-- Here -->
		<section name="orderMade" label="" borderLabel="" ref="/">
			<choice name="orderMadeOption" label="" ref="//ord:OrderMadeUnder">
				<option name="s100" label="Made under Section 100 Powers of Criminal Courts (Sentencing) Act 2000" value="Section100" selected="true"/>
				<option name="s233" label="Made under Section 233 of the Sentencing Act 2020" value="Section233" selected="false"/>
			</choice>
		</section>
		<section name="defendant" label="" borderLabel="Defendant" ref="/">
			<date name="xxx2" label="Conviction Date:" ref="//ord:ConvictionDate"/>
			<section name="commitForSentence" label="" switchLabel="Committed for Sentence By" borderLabel="" borderRaised="false" switchable="true" ref="//ord:CommittingCourt/@selected" selectedValue="true" unselectedValue="false">
				<courttype name="courttype" label="tests" crownref="Milton Keynes" magistratesref="Leeds" youthref="Reading" crowncourt="false" magistratecourt="true" youthcourt="false" courtlabel="false" ref="//ord:CommittingCourt/ord:CourtHouseName"/>
			</section>
		</section>
		<section name="risk" label="" borderLabel="" ref="/">
			<section name="riskVulnerability" label="" switchLabel="Risk or Vulnerability factors if known to the court" borderLabel="" borderRaised="false" switchable="true" ref="//ord:RiskVulnerabilityFactors/@selected" selectedValue="true" unselectedValue="false">
				<textarea name="riskText" ref="//ord:RiskVulnerabilityFactors/ord:RiskText" label="" topLabel="" rows="8" cols="14"/>			
			</section>
		</section>
		<section name="courtOrdered" label="" borderLabel="Court Ordered" ref="/">
			<date name="xxx2" label="Sentence Date:" ref="//ord:OrderHeader/ord:OrderDate"/>
			<section name="orderPeriod" borderLabel="Order Period" label="">
				<durationdate name="durationdate" dayattribute="true" weekattribute="false" monthattribute="true" yearattribute="true" defaultrequired="false" defaultdurationvalue="12" label="" ref="/" ref1="/ord:Order/ord:OrderData/*/ord:OrderPeriod/ord:Period"/>
				<section name="section105" label="" switchLabel="Section 105 / 243 Option" borderLabel="" borderRaised="false" switchable="true" ref="/ord:Order/ord:OrderData/*/ord:OrderPeriod/ord:Section105/@selected" selectedValue="true" unselectedValue="false">
					<durationdate name="durationdate" dayattribute="true" weekattribute="false" monthattribute="true" yearattribute="true" defaultrequired="false" defaultdurationvalue="12" label="" ref="/" ref1="/ord:Order/ord:OrderData/*/ord:OrderPeriod/ord:Section105/ord:Period"/>
				</section>
			</section>
			<section name="creditForBail" label="" switchLabel="Credit for time spent on bail" borderLabel="Credit for time spent on bail" borderRaised="false" switchable="true" ref="//ord:CreditForBail/@selected" selectedValue="true" unselectedValue="false">
				<choice name="chooseCreditForBailSection" label="" ref="/ord:Order/ord:OrderData/*/ord:CreditForBail/ord:CreditForTimeOnBailSection">
					<option name="section240a" label="Section 240A Criminal Justice Act 2003" value="section240a"/>
					<option name="section325" label="Section 325 Sentencing Act 2020" value="section325" selected="true"/>
				</choice>
				<durationdate name="durationdate" dayattribute="true" weekattribute="false" monthattribute="false" yearattribute="false" label="Number of days" defaultrequired="false" defaultdurationvalue="12" ref="/" ref1="//ord:Order/ord:OrderData/*/ord:CreditForBail/ord:Term"/>
			</section>
			<!-- Requirements Section Start -->
			<section name="requirementsHeader" label="" borderLabel="Requirements" borderRaised="true" switchable="false">
				<section name="trail" label="" switchLabel="Trail Monitoring Option" borderLabel="Trail Monitoring Requirement" borderRaised="false" switchable="true" ref="/ord:Order/ord:OrderData/*/ord:DTOrderRequirements/ord:TrailMonitoringRequirement/@selected" selectedValue="true" unselectedValue="false">
					<textfield name="trailduration" valueRange="true" minVal="0" maxVal="999" maxLength="3" type="int" label="No. of days:                            " length="5" ref="/ord:Order/ord:OrderData/*/ord:DTOrderRequirements/ord:TrailMonitoringRequirement/ord:Duration" numeric="Y"/>
				</section>
			</section>
			<section name="additionalNotes" label="" switchLabel="Additional Notes Option" borderLabel="Additional Notes" borderRaised="false" switchable="true" ref="//ord:AdditionalNotes/@selected" selectedValue="true" unselectedValue="false">
				<textarea name="additonalNotesValue" ref="//ord:AdditionalNotes" label="" topLabel="Additional Notes:" rows="10" cols="15"/>
			</section>
		</section>
		<fixedlist name="relatedCases" label="Associated Cases" rows="123" cols="60" ref="//ord:AssociatedCases/ord:AssociatedCase"/>
	</form>
</template>
