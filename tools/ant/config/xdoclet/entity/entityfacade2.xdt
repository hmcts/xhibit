  public static <XDtEjbDataObj:dataObjectClass/> update(<XDtEjbDataObj:dataObjectClass/> data) {

   try {
      <XDtEjbIntf:componentInterface type="local"/> obj = home.findByPrimaryKey(data.getPrimaryKey());
      
      <XDtClass:ifClassTagValueEquals tagName="xhibit.auditable" value="true">
      <XDtEjbDataObj:dataObjectClass/> previousData = obj.getData();
      
      <XDtMethod:ifHasMethod name="getObsInd">
      previousData.setObsInd(data.getObsInd());	
      </XDtMethod:ifHasMethod>

      auditDetails.put(facadeClassName, previousData);
      doAudit(auditDetails,true);
      </XDtClass:ifClassTagValueEquals>

      <XDtMethod:ifHasMethod name="getVersion">
      if (!obj.getVersion().equals(data.getVersion()))
      {
        String errMessage = "OptimisticLock exception - Entity: " + obj.getVersion() + ", Vo: " + data.getVersion();
        OptimisticLockException opEx = new OptimisticLockException(errMessage);
        CSServices.getDefaultErrorHandler().handleError(opEx, clazz);
        throw opEx;
      }
      else
      {
        obj.setData(data);
        return obj.getData();
      }
      </XDtMethod:ifHasMethod>

      <XDtMethod:ifDoesntHaveMethod name="getVersion">
      obj.setData(data);
      return obj.getData();
      </XDtMethod:ifDoesntHaveMethod>

    } catch(ObjectNotFoundException ex) {
      throw new <XDtEjb:ejbName/>BeanNotFoundException(ex);
