<XDtClass:ifClassTagValueEquals tagName="xhibit.auditable" value="true">
  private static void doAudit(Hashtable hashtable, boolean successful){
    AuditTrailEvent event = auditService.getAuditTrailEvent(hashtable);

    if(event == null)
        return;

    event.setSuccess(successful);
    auditService.createAuditRecord(event);
  }
