   private boolean setCmr($table.dataClassName data)
   {
      boolean modified = false;
#foreach($relationShipRole in $table.oneRelationshipRoles)
#foreach($columnMap in $relationShipRole.targetRole.columnMaps)
#set($fkColumn = $table.getColumn($columnMap.foreignKey))
        $fkColumn.javaType ${fkColumn.variableName}Bean = ${fkColumn.getterName}();
        $fkColumn.javaType ${fkColumn.variableName}Data = data.${fkColumn.getterName}();
        if (${fkColumn.variableName}Data != null)
        {
           if (!${fkColumn.variableName}Data.equals(${fkColumn.variableName}Bean))
           {
                $table.getSetterName($relationShipRole)(${table.getClassName($relationShipRole)}BeanHelper2.findByPrimaryKey(${fkColumn.variableName}Data));
                modified = true;
           }
        }
        else
        {
           if (${fkColumn.variableName}Bean != null)
           {
                $table.getSetterName($relationShipRole)(null);
                modified = true;
           }
        }
#end
#end
      return modified;
   }


