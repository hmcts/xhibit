   <target name="promote.nightly">
     <property file="build.properties"/>
     <input
        message="Please Enter the name of the Existing nightly TAG to promote"
        addproperty="existing.tag"
     />
      
     <buildnumber/> 
     <property name="rc.tag" value="RELEASE${cvs_safe_version}_RC${build.number}" />
     <echo message=""/>
     <echo message="****************************************************************"/>
     <echo message="       A new cvs TAG will be created called ${rc.tag} "/>
     <echo message="       From the Exising CVS tag ${existing.tag}"/>
     <echo message="****************************************************************"/>
     <echo message=""/>
      
      <input
        message="is this information correct and do you want to continue ?"
        validargs="y,n"
        addproperty="do.promo"
      />
      <condition property="do.abort">
         <equals arg1="n" arg2="${do.promo}"/>
      </condition>
      <fail if="do.abort">Promotion aborted by user.</fail>

      <cvs command="rtag -r${existing.tag} ${rc.tag} XHIBIT" />
      <echo message="Candidate Promotion Complete - please RECORD THIS PROMOTION ON THE WIKI !"/>
   </target>
   
   <target name="promote.candidate">
      <!-- import build.properties --> 
      <property file="./build.properties"/> 
     <input
        message="Please Enter the name of the Existing Release Candidate TAG to promote"
        addproperty="existing.tag"
     />
    
     <property name="new.tag" value="RELEASE_${cvs_safe_version}"/>

     <echo message=""/>
     <echo message="****************************************************************"/>
     <echo message="       A new cvs TAG will be created called ${new.tag} "/>
     <echo message="       From the Exising CVS tag ${existing.tag}"/>
     <echo message="       if the version is incorect you should edit the build.properties"/>
     <echo message="       in the /build/release directory and update version and cvs_safe_version"/>
     <echo message="       values as appropriate "/>
     <echo message="****************************************************************"/>
     <echo message=""/>
      
      <input
        message="is this information correct and do you want to continue ?"
        validargs="y,n"
        addproperty="do.promo"
      />

      <condition property="do.abort">
         <equals arg1="n" arg2="${do.promo}"/>
      </condition>
      
      <fail if="do.abort">Promotion aborted by user.</fail>
      
      <cvs command="rtag -r${existing.tag} ${new.tag} XHIBIT" />

   </target>     

    <macrodef name="sh">
      <attribute name="dir" default="${basedir}"/>
      <text name="cmd" trim="true"/>
      <sequential>
        <exec executable="sh" dir="@{dir}" failonerror="true">
          <arg value="-c"/>
          <arg value="@{cmd}"/>
        </exec>
      </sequential>
    </macrodef>
                                                                                                 
</project>
