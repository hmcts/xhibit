    </security-params>
  </connection-factory>
  <!--
    Distributed Queues
    -->
  <uniform-distributed-queue name="MessageBrokerQueue">
    <sub-deployment-name>midcluster-Subdeployment</sub-deployment-name>
    <delivery-params-overrides>
      <redelivery-delay>5000</redelivery-delay>
    </delivery-params-overrides>
    <delivery-failure-params>
      <error-destination>DeadLetterQueue</error-destination>
      <redelivery-limit>3</redelivery-limit>
      <expiration-policy>Redirect</expiration-policy>
    </delivery-failure-params>
    <jndi-name>xhibit/jms/MessageBrokerQueue</jndi-name>
    <load-balancing-policy>Round-Robin</load-balancing-policy>
    <forward-delay>60</forward-delay>
  </uniform-distributed-queue>
  <uniform-distributed-queue name="ExissMessageBuilderQueue">
    <sub-deployment-name>midcluster-Subdeployment</sub-deployment-name>
    <delivery-params-overrides>
