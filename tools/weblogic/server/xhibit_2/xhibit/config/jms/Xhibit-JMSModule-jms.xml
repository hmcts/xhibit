<?xml version='1.0' encoding='UTF-8'?>
<weblogic-jms xmlns="http://www.bea.com/ns/weblogic/90" xmlns:sec="http://www.bea.com/ns/weblogic/90/security" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:wls="http://www.bea.com/ns/weblogic/90/security/wls" xsi:schemaLocation="http://www.bea.com/ns/weblogic/920 http://www.bea.com/ns/weblogic/920.xsd">
<!--
    Connection Factories
    -->
  <connection-factory name="PublicDisplayConnectionFactory">
    <sub-deployment-name>midcluster-Subdeployment</sub-deployment-name>
    <jndi-name>PublicDisplayConnectionFactory</jndi-name>
    <transaction-params>
      <xa-connection-factory-enabled>true</xa-connection-factory-enabled>
    </transaction-params>
    <security-params>
      <attach-jmsx-user-id>false</attach-jmsx-user-id>
    </security-params>
  </connection-factory>
  <connection-factory name="CSJMSConnectionFactory">
    <sub-deployment-name>midcluster-Subdeployment</sub-deployment-name>
    <jndi-name>CSJMSConnectionFactory</jndi-name>
    <security-params>
      <attach-jmsx-user-id>false</attach-jmsx-user-id>
    </security-params>
  </connection-factory>
  <connection-factory name="ExissConnectionFactory">
    <sub-deployment-name>midcluster-Subdeployment</sub-deployment-name>
    <jndi-name>ExissConnectionFactory</jndi-name>
    <transaction-params>
      <xa-connection-factory-enabled>true</xa-connection-factory-enabled>
    </transaction-params>
    <security-params>
      <attach-jmsx-user-id>false</attach-jmsx-user-id>
    </security-params>
  </connection-factory>
  <connection-factory name="AuditTrailConnectionFactory">
