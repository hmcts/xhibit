<?xml version="1.0" encoding="utf-8" ?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" 
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" 
                  name="EchoService" 
                  targetNamespace="http://schemas.cjse.gov.uk/echo/wsdl/2006-08"
                  xmlns:ew="http://schemas.cjse.gov.uk/echo/wsdl/2006-08"
                  xmlns:xs="http://www.w3.org/2001/XMLSchema">
    
    <wsdl:types>
        <xs:schema 
            xmlns:xs="http://www.w3.org/2001/XMLSchema"
            targetNamespace="http://schemas.cjse.gov.uk/echo/wsdl/2006-08"  >
            <xs:element name="EchoString" type="xs:string"/>
        </xs:schema>
    </wsdl:types>

    <wsdl:message name="EchoRequestMessage">
        <wsdl:part name="echoin" element="ew:EchoString"/>
    </wsdl:message>

    <wsdl:message name="EchoResponseMessage">
        <wsdl:part name="echoout" element="ew:EchoString"/>
    </wsdl:message>

    <wsdl:portType name="EchoPort">
        <wsdl:operation name="Echo">
            <wsdl:input message="ew:EchoRequestMessage"/>
            <wsdl:output message="ew:EchoResponseMessage"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="EchoBinding" type="ew:EchoPort">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="Echo">
            <soap:operation soapAction="http://cjse/echo"/>
            <wsdl:input>
                <soap:body message="ew:EchoRequestMessage" part="echoin" use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body message="ew:EchoResponseMessage" part="echoout" use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="EchoService">
        <wsdl:port binding="ew:EchoBinding" name="EchoServicePort">
            <soap:address location="http://scjsegateway1:7071/services/echo"/>
        </wsdl:port>
    </wsdl:service>

</wsdl:definitions>
