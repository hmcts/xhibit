<?xml version="1.0" encoding="UTF-8"?>

<project basedir="." default="all" name="ResultsCommon">

    <description>
        Common classes results rewrite
    </description>

    <import file="./../../tools/ant/framework.xml" />

    <property name="project.author" value="Abdul Rahim Hussain"/>

    <property name="project.type.builds.jar" value="marker"/>
    <property name="project.type.requires.compilation" value="marker"/>

    <!--
      =======================================================================
        Initialise Override
      =======================================================================
      -->
    <target name="initialise" unless="skip.initialise" depends="framework.initialise">
        <log target="initialise"/>
        <path id="compile.classpath">
            <fileset dir="${build.dest.dir}">
            	<include name="Framework.jar" />
            	<include name="XhibitValues.jar" />
            	<include name="CommonValue.jar" />
            	<include name="XhibitXmlBinding.jar" />
            </fileset>
        </path>
    </target>

    <!--
    <target name="prepareMVO" depends="all">
        <jar destfile="build\ResultsMVO.jar">
            <fileset dir="classes" includes="**/*MVO*"/>
            <fileset dir="src" includes="**/*MVO*"/>
        </jar>
    </target>
    -->
</project>
