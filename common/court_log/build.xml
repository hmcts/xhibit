<?xml version="1.0" encoding="UTF-8"?>

<project basedir="." default="all" name="CourtLogCommon">

    <description>
        Common classes for the Public DisplayRewrite
    </description>

    <import file="./../../tools/ant/framework.xml" />

    <property name="project.author" value="Bob Boothby, Neil Ellis, Rakesh Lakhani"/>

    <property name="project.type.builds.jar" value="marker"/>
    <property name="project.type.requires.compilation" value="marker"/>

    <!--
      =======================================================================
        Initialise Override
      =======================================================================
      -->
    <target name="initialise" unless="skip.initialise" depends="framework.initialise">
        <log target="initialise"/>
	    <path id="compile.classpath">
            <path refid="lib.classpath"/>
            <pathelement location="${build.dest.dir}/Framework.jar"/>
	    </path>
    </target>
</project>
